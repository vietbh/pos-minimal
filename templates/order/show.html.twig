{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'order.title'|trans }} #{{ order.orderNumber }}{% endblock %}

{% block stylesheets %}
    <style>
        .order-page { max-width: 760px; margin: 0 auto; padding: 16px 14px 32px; }
        .order-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
        .order-head h1 { margin: 0; font-size: 1.35rem; }
        .order-back { display: inline-flex; align-items: center; min-height: 48px; margin-bottom: 14px; padding: 0 4px; }
        .order-money-total { font-size: 22px; }
        .order-status { display: inline-block; padding: 5px 9px; border-radius: 999px; background: #f1f5f9; font-size: .8rem; font-weight: 800; }
        .order-section { margin-top: 16px; padding: 14px; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; }
        .order-section h2 { margin: 0 0 12px; font-size: 20px; }
        .order-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid #f1f5f9; }
        .order-row:last-child { border-bottom: 0; }
        .muted { color: #64748b; }
        .strong { font-weight: 800; }
        .order-item { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
        .order-item:last-child { border-bottom: 0; }
        .order-item-meta { color: #64748b; font-size: .88rem; }
        .order-payment, .order-debt { padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
        .order-payment:last-child, .order-debt:last-child { border-bottom: 0; }
    </style>
{% endblock %}

{% block authenticated_body %}
<main class="order-page">
    <a class="order-back" href="{{ path('orders_index', backQuery) }}">{{ 'order.back'|trans }}</a>
    <header class="order-head">
        <div>
            <h1>#{{ order.orderNumber }}</h1>
            <div class="muted">{{ order.createdAt|date('d/m/Y H:i:s') }}</div>
        </div>
        <span class="order-status">{{ order.status.value|title }}</span>
    </header>

    <section class="order-section" aria-labelledby="order-summary">
        <h2 id="order-summary">{{ 'order.summary'|trans }}</h2>
        <div class="order-row"><span class="muted">{{ 'common.customer'|trans }}</span><span>{{ order.customerName }}{% if order.customerPhone %}<br><span class="muted">{{ order.customerPhone }}</span>{% endif %}</span></div>
        <div class="order-row"><span class="muted">{{ 'order.created_by'|trans }}</span><span>{{ order.createdBy }}</span></div>
        {% if order.completedAt %}<div class="order-row"><span class="muted">{{ 'order.completed'|trans }}</span><span>{{ order.completedAt|date('d/m/Y H:i:s') }}</span></div>{% endif %}
        {% if order.cancelledAt %}<div class="order-row"><span class="muted">{{ 'stat.cancelled'|trans }}</span><span>{{ order.cancelledAt|date('d/m/Y H:i:s') }}</span></div>{% endif %}
        <div class="order-row"><span class="muted">{{ 'order.subtotal'|trans }}</span><span>{{ order.subtotal|money_vnd }}</span></div>
        {% if order.discount != '0.00' %}
            <div class="order-row"><span class="muted">{{ 'pos.cart.discount'|trans }}{% if order.discountPercent > 0 %} ({{ order.discountPercent }}%) {% endif %}</span><span>-{{ order.discount|money_vnd }}</span></div>
            {% if order.manualDiscount != '0.00' %}<div class="order-row"><span class="muted">Giảm trực tiếp</span><span>-{{ order.manualDiscount|money_vnd }}</span></div>{% endif %}
        {% endif %}
        <div class="order-row"><span class="strong">{{ 'order.total'|trans }}</span><span class="strong order-money-total">{{ order.total|money_vnd }}</span></div>
        <div class="order-row"><span class="muted">{{ 'order.paid'|trans }}</span><span>{{ order.paidAmount|money_vnd }}</span></div>
        {% if order.status.value != 'COMPLETED' and order.debtAmount != '0.00' %}<div class="order-row"><span class="muted">{{ 'order.remaining_debt'|trans }}</span><span>{{ order.debtAmount|money_vnd }}</span></div>{% endif %}
        {% if order.note %}<div class="order-row"><span class="muted">{{ 'admin.note'|trans }}</span><span>{{ order.note }}</span></div>{% endif %}
    </section>

    {% if is_granted('POS_ACCESS') and order.items is not empty %}
        <section class="order-section order-copy-pos" aria-labelledby="order-copy-pos">
            <h2 id="order-copy-pos">{{ 'order.copy_to_pos.title'|trans }}</h2>
            <p class="muted">{{ 'order.copy_to_pos.help'|trans }}</p>
            <a class="button primary" href="{{ path('pos', {copyFromOrder: order.id}) }}">{{ 'order.copy_to_pos.button'|trans }}</a>
        </section>
    {% endif %}

    <section class="order-section" aria-labelledby="order-items">
        <h2 id="order-items">{{ 'common.products'|trans }}</h2>
        {% for item in order.items %}
            <div class="order-item">
                <div><div class="strong">{{ item.productName }}</div><div class="order-item-meta">{{ item.sku ?? 'Không có SKU' }} · {{ item.quantity }} × {{ item.unitPrice|money_vnd }}</div></div>
                <div class="strong">{{ item.subtotal|money_vnd }}</div>
            </div>
        {% endfor %}
    </section>

    {% set hasBankTransferPayment = false %}
    {% for payment in order.payments %}
        {% if payment.method == 'BANK_TRANSFER' %}{% set hasBankTransferPayment = true %}{% endif %}
    {% endfor %}
    {% if order.externalTransaction %}
        <section class="order-section order-bank-webhook" aria-labelledby="order-bank-webhook">
            <h2 id="order-bank-webhook">{{ 'order.bank_details'|trans }}</h2>
            <div class="order-row"><span class="muted">{{ 'common.status'|trans }}</span><span class="strong">{{ order.externalTransaction.status }}</span></div>
            <div class="order-row"><span class="muted">{{ 'order.provider'|trans }}</span><span>{{ order.externalTransaction.provider }}</span></div>
            <div class="order-row"><span class="muted">{{ 'order.transaction_id'|trans }}</span><span>{{ order.externalTransaction.externalTransactionId }}</span></div>
            <div class="order-row"><span class="muted">{{ 'common.amount'|trans }}</span><span class="strong">{{ order.externalTransaction.amount|money_vnd }}</span></div>
            <div class="order-row"><span class="muted">{{ 'order.occurred_at'|trans }}</span><span>{{ order.externalTransaction.occurredAt|date('d/m/Y H:i:s') }}</span></div>
            {% if order.externalTransaction.reference %}<div class="order-row"><span class="muted">{{ 'admin.payment_reference'|trans }}</span><span>{{ order.externalTransaction.reference }}</span></div>{% endif %}
            <div class="order-row"><span class="muted">{{ 'order.description'|trans }}</span><span>{{ order.externalTransaction.description }}</span></div>
        </section>
    {% elseif hasBankTransferPayment %}
        <section class="order-section order-bank-webhook" aria-labelledby="order-bank-webhook">
            <h2 id="order-bank-webhook">{{ 'order.bank_details'|trans }}</h2>
            <div class="order-row"><span class="muted">{{ 'order.webhook_status'|trans }}</span><span class="strong">{{ 'order.webhook_waiting'|trans }}</span></div>
            <p class="muted" style="margin:10px 0 0">{{ 'order.webhook_note'|trans }}</p>
        </section>
    {% endif %}

    <section class="order-section" aria-labelledby="order-payments">
        <h2 id="order-payments">{{ 'common.payments'|trans }}</h2>
        {% if order.payments is empty %}
            <div class="muted">{{ 'order.no_payments'|trans }}</div>
        {% else %}
            {% for payment in order.payments %}
                <div class="order-payment">
                    <div class="order-row"><span>{{ payment.method|title }}</span><span class="strong">{{ payment.amount|money_vnd }}</span></div>
                    <div class="order-item-meta">{{ payment.createdAt|date('d/m/Y H:i') }} · {{ payment.username }}{% if payment.reference %} · {{ payment.reference }}{% endif %}</div>
                </div>
            {% endfor %}
        {% endif %}
    </section>

    {% if order.status.value == 'COMPLETED' and (is_granted('ORDER_CANCEL') or is_granted('ORDER_REFUND')) %}
        <section class="order-section" aria-labelledby="order-lifecycle">
            <h2 id="order-lifecycle">{{ 'order.actions'|trans }}</h2>
            <div data-controller="order-lifecycle" data-order-lifecycle-url-value="" data-order-lifecycle-csrf-value="{{ csrf_token('order_lifecycle') }}" data-order-lifecycle-reason-required-message-value="{{ 'order.reason_required'|trans }}" data-order-lifecycle-failed-message-value="{{ 'order.operation_failed'|trans }}"
                data-order-lifecycle-error-messages-value='{{ {AUTHENTICATION_REQUIRED: 'order.error_authentication'|trans, ACCESS_DENIED: 'order.error_access_denied'|trans, CSRF_INVALID: 'order.error_csrf'|trans, VALIDATION_ERROR: 'order.error_validation'|trans, ORDER_NOT_FOUND: 'order.error_not_found'|trans, IDEMPOTENCY_CONFLICT: 'order.error_idempotency_conflict'|trans, IDEMPOTENCY_IN_PROGRESS: 'order.error_idempotency_in_progress'|trans, ORDER_ALREADY_CANCELLED: 'order.error_already_cancelled'|trans, ORDER_ALREADY_REFUNDED: 'order.error_already_refunded'|trans, ORDER_INVALID_STATE: 'order.error_invalid_state'|trans, REFUND_ALREADY_PROCESSED: 'order.error_refund_processed'|trans, BUSINESS_RULE_VIOLATION: 'order.error_business_rule'|trans, INTERNAL_ERROR: 'order.operation_failed'|trans}|json_encode|e('html_attr') }}'>
                <div class="modal-actions">
                    {% if is_granted('ORDER_CANCEL') %}<button type="button" data-action="click->order-lifecycle#open" data-url="{{ path('order_cancel',{id:order.id}) }}">{{ 'order.cancel'|trans }}</button>{% endif %}
                    {% if is_granted('ORDER_REFUND') %}<button type="button" data-action="click->order-lifecycle#open" data-url="{{ path('order_refund',{id:order.id}) }}">{{ 'order.refund'|trans }}</button>{% endif %}
                </div>
                <div class="modal-backdrop" hidden data-order-lifecycle-target="modal">
                    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="lifecycle-title">
                        <h2 id="lifecycle-title">{{ 'order.confirm_operation'|trans }}</h2>
                        <p class="muted">{{ 'order.reason_help'|trans }}</p>
                        <form data-action="submit->order-lifecycle#submit">
                            <label>{{ 'common.reason'|trans }}<textarea data-order-lifecycle-target="reason" required maxlength="255" rows="4"></textarea></label>
                            <p class="error" role="alert" hidden data-order-lifecycle-target="error"></p>
                            <div class="modal-actions"><button type="button" data-action="click->order-lifecycle#close">{{ 'order.close'|trans }}</button><button type="submit" data-order-lifecycle-target="submit">{{ 'order.confirm'|trans }}</button></div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {% if order.status.value != 'COMPLETED' and order.debt and order.debtAmount != '0.00' and order.status.value != 'CANCELLED' and order.status.value != 'REFUNDED' %}
        <section class="order-section" aria-labelledby="order-debt">
            <h2 id="order-debt">{{ 'debt.title'|trans }}</h2>
            <div class="order-row"><span class="muted">{{ 'common.status'|trans }}</span><span>{{ order.debt.status|title }}</span></div>
            <div class="order-row"><span class="muted">{{ 'stat.original'|trans }}</span><span>{{ order.debt.originalAmount|money_vnd }}</span></div>
            <div class="order-row"><span class="muted">{{ 'order.debt_paid'|trans }}</span><span>{{ order.debt.paidAmount|money_vnd }}</span></div>
            <div class="order-row"><span class="strong">{{ 'stat.outstanding'|trans }}</span><span class="strong">{{ order.debt.remainingAmount|money_vnd }}</span></div>
        </section>
    {% endif %}
</main>
{% endblock %}
