{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'orders.page_title'|trans }}{% endblock %}
{% block authenticated_body %}
<main class="page-shell orders-page">
  <header class="page-header orders-header">
    <div><p class="page-eyebrow">{{ 'orders.eyebrow'|trans }}</p><h1>{{ 'orders.title'|trans }}</h1><p class="muted">{{ 'orders.subtitle'|trans }}</p></div>
    {% if is_granted('POS_ACCESS') %}<a class="button" href="{{ path('pos') }}">{{ 'orders.open_pos'|trans }}</a>{% endif %}
  </header>
  <form method="get" class="search-form orders-filters" role="search" aria-label="{{ 'orders.search_label'|trans }}">
    <label>{{ 'orders.search'|trans }}<input name="q" value="{{ search }}" maxlength="{{ maxSearchLength }}" placeholder="{{ 'orders.search_placeholder'|trans }}" autocomplete="off"></label>
    <label>{{ 'orders.status'|trans }}<select name="status"><option value="">{{ 'orders.all_statuses'|trans }}</option>{% for item in statuses %}<option value="{{ item.value }}"{% if status is same as(item) %} selected{% endif %}>{{ statusLabels[item.value] }}</option>{% endfor %}</select></label>
    <div class="orders-date-grid"><label>{{ 'orders.from'|trans }}<input type="date" name="from" value="{{ from ?? '' }}"></label><label>{{ 'orders.to'|trans }}<input type="date" name="to" value="{{ to ?? '' }}"></label></div>
    <div class="orders-filter-actions"><button class="primary" type="submit">{{ 'orders.search_action'|trans }}</button><a class="button" href="{{ path('orders_index') }}">{{ 'orders.clear'|trans }}</a></div>
  </form>
  <div class="orders-summary" role="status" aria-live="polite"><span>{{ 'orders.count'|trans({'%count%': orders.totalItems}) }}</span>{% if search or status or from or to %}<span class="filter-badge">{{ 'orders.filtered'|trans }}</span>{% endif %}</div>
  {% if orders.items is empty %}<div class="empty-state orders-empty"><strong>{{ 'orders.empty_title'|trans }}</strong><span>{{ 'orders.empty_message'|trans }}</span></div>
  {% else %}<section class="card-list orders-list" aria-label="{{ 'orders.list_label'|trans }}">{% for item in orders.items %}
    <a class="card order-card" href="{{ path('orders_show', {id: item.id}|merge(app.request.query.all)) }}">
      <div class="order-card-top"><div><strong>#{{ item.orderNumber }}</strong><span class="muted">{{ item.customerName ?? 'orders.walk_in_customer'|trans }}</span></div><span class="status-pill">{{ statusLabels[item.status.value] }}</span></div>
      <div class="order-card-bottom"><span class="muted">{{ item.createdAt|date('d/m/Y H:i') }}</span><strong>{{ item.total|money_vnd }}</strong></div>
      {% if item.debtAmount != '0.00' %}<div class="order-debt">{{ 'orders.remaining_debt'|trans }}: {{ item.debtAmount|money_vnd }}</div>{% endif %}
    </a>{% endfor %}</section>
  {% set previousPage = orders.page - 1 %}{% set nextPage = orders.page + 1 %}
  <nav class="pagination orders-pagination" aria-label="{{ 'orders.pagination'|trans }}"><a class="button" href="{{ path('orders_index', app.request.query.all|merge({page: previousPage})) }}" aria-disabled="{{ orders.page <= 1 ? 'true' : 'false' }}">{{ 'orders.previous'|trans }}</a><span aria-current="page">{{ 'orders.page'|trans({'%page%':orders.page,'%total%':orders.totalPages()}) }}</span><a class="button" href="{{ path('orders_index', app.request.query.all|merge({page: nextPage})) }}" aria-disabled="{{ orders.page >= orders.totalPages() ? 'true' : 'false' }}">{{ 'orders.next'|trans }}</a></nav>{% endif %}
</main>
{% endblock %}
