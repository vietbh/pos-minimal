{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'order.title'|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        .orders-page { max-width: 820px; margin: 0 auto; padding: 16px 14px 40px; }
        .orders-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
        .orders-header h1 { margin: 0; font-size: 24px; line-height: 1.2; }
        .orders-header p { margin: 6px 0 0; color: #475569; }
        .orders-pos-link { min-height: 48px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 10px; display: inline-flex; align-items: center; text-decoration: none; font-weight: 700; background: #fff; }
        .orders-filters { display: grid; gap: 12px; padding: 14px; margin-bottom: 14px; background: #fff; border: 1px solid #cbd5e1; border-radius: 14px; }
        .orders-filters label { display: grid; gap: 6px; color: #172033; font-size: 16px; font-weight: 700; }
        .orders-filters input, .orders-filters select { width: 100%; min-height: 48px; box-sizing: border-box; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; font-size: 17px; }
        .orders-filter-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .orders-filter-actions { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; }
        .orders-filter-actions button, .orders-clear { min-height: 48px; padding: 0 16px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 16px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; }
        .orders-filter-actions button { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
        .orders-clear { background: #fff; }
        .orders-summary { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 12px 2px; color: #475569; font-size: 15px; }
        .orders-list { display: grid; gap: 10px; }
        .order-card { display: block; color: inherit; text-decoration: none; padding: 14px; border: 1px solid #cbd5e1; border-radius: 14px; background: #fff; }
        .order-card:focus-visible, .orders-pos-link:focus-visible, .orders-clear:focus-visible, .orders-filter-actions button:focus-visible, .orders-pagination a:focus-visible { outline: 3px solid #93c5fd; outline-offset: 2px; }
        .order-card-top, .order-card-bottom { display: flex; justify-content: space-between; gap: 12px; }
        .order-card-bottom { align-items: baseline; }
        .order-number { font-weight: 800; font-size: 17px; }
        .order-customer, .order-meta { color: #475569; font-size: 15px; }
        .order-customer { margin-top: 4px; }
        .order-total { font-weight: 800; font-size: 18px; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .order-status { display: inline-flex; align-items: center; min-height: 32px; padding: 0 9px; border-radius: 999px; background: #f1f5f9; font-size: 13px; font-weight: 800; white-space: nowrap; }
        .order-debt { margin-top: 9px; color: #a16207; font-size: 15px; font-weight: 700; }
        .orders-empty { padding: 30px 18px; text-align: center; color: #475569; border: 1px dashed #cbd5e1; border-radius: 14px; background: #fff; }
        .orders-empty strong, .orders-empty span { display: block; }
        .orders-empty strong { color: #172033; font-size: 18px; }
        .orders-empty span { margin-top: 6px; }
        .orders-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; margin-top: 18px; }
        .orders-pagination a { min-height: 48px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 10px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; background: #fff; font-weight: 700; box-sizing: border-box; }
        .orders-pagination a:last-child { justify-self: end; }
        .orders-pagination a[aria-disabled="true"] { color: #94a3b8; pointer-events: none; background: #f8fafc; }
        .orders-page-indicator { text-align: center; color: #475569; font-size: 15px; }
        @media (min-width: 640px) {
            .orders-filters { grid-template-columns: 2fr 1fr; }
            .orders-filter-row { grid-column: 1 / -1; }
            .orders-filter-actions { grid-column: 1 / -1; }
        }
        @media (max-width: 480px) {
            .orders-header { align-items: stretch; }
            .orders-pos-link { flex: 0 0 auto; }
            .orders-filter-row { grid-template-columns: 1fr; }
            .orders-filter-actions { grid-template-columns: 1fr 1fr; }
            .orders-summary { align-items: flex-start; flex-direction: column; }
            .order-card-top { align-items: flex-start; }
        }
        @media (prefers-reduced-motion: reduce) { .order-card, .orders-pagination a { scroll-behavior: auto; } }
    </style>
{% endblock %}

{% block authenticated_body %}
<main class="orders-page">
    <header class="orders-header">
        <div>
            <h1>{{ 'order.title'|trans }}</h1>
            <p>{{ 'order.help'|trans }}</p>
        </div>
        {% if is_granted('POS_ACCESS') %}
            <a class="orders-pos-link" href="{{ path('pos') }}">{{ 'order.open_pos'|trans }}</a>
        {% endif %}
    </header>

    <form method="get" class="orders-filters" role="search" aria-label="{{ 'order.search_aria'|trans }}">
        <label>
            {{ 'common.search'|trans }}
            <input name="q" value="{{ search }}" maxlength="{{ maxSearchLength }}" placeholder="{{ 'order.search_placeholder'|trans }}" autocomplete="off">
        </label>
        <label>
            {{ 'common.status'|trans }}
            <select name="status">
                <option value="">{{ 'order.all_status'|trans }}</option>
                {% for item in statuses %}
                    <option value="{{ item.value }}"{% if status is same as(item) %} selected{% endif %}>{{ statusLabels[item.value] }}</option>
                {% endfor %}
            </select>
        </label>
        <div class="orders-filter-row">
            <label> {{ 'order.from'|trans }} <input type="date" name="from" value="{{ from ?? '' }}" aria-label="{{ 'order.from'|trans }}"></label>
            <label> {{ 'order.to'|trans }} <input type="date" name="to" value="{{ to ?? '' }}" aria-label="{{ 'order.to'|trans }}"></label>
        </div>
        <div class="orders-filter-actions">
            <button type="submit">{{ 'common.search'|trans }}</button>
            <a class="orders-clear" href="{{ path('orders_index') }}">{{ 'order.clear_filters'|trans }}</a>
        </div>
    </form>

    <div class="orders-summary" role="status" aria-live="polite">
        <span>{{ orders.totalItems }} đơn hàng</span>
        {% if search or status or from or to %}<span>{{ 'order.filters_applied'|trans }}</span>{% endif %}
    </div>

    {% if orders.items is empty %}
        <div class="orders-empty">
            <strong>{{ 'order.not_found'|trans }}</strong>
            <span>{{ 'order.try_filters'|trans }}</span>
        </div>
    {% else %}
        <section class="orders-list" aria-label="{{ 'order.list_aria'|trans }}">
            {% for item in orders.items %}
                <a class="order-card" href="{{ path('orders_show', {id: item.id}|merge(app.request.query.all)) }}">
                    <div class="order-card-top">
                        <div>
                            <div class="order-number">#{{ item.orderNumber }}</div>
                            <div class="order-customer">{{ item.customerName ?? 'order.customer_retail'|trans }}</div>
                        </div>
                        <span class="order-status">{{ statusLabels[item.status.value] }}</span>
                    </div>
                    <div class="order-card-bottom" style="margin-top: 12px">
                        <div class="order-meta">{{ item.createdAt|date('d/m/Y H:i') }}</div>
                        <div class="order-total">{{ item.total|money_vnd }}</div>
                    </div>
                    {% if item.status.value != 'COMPLETED' and item.debtAmount != '0.00' %}
                        <div class="order-debt">{{ 'order.debt_prefix'|trans }} {{ item.debtAmount|money_vnd }}</div>
                    {% endif %}
                </a>
            {% endfor %}
        </section>

        {% set previousPage = orders.page - 1 %}
        {% set nextPage = orders.page + 1 %}
        <nav class="orders-pagination" aria-label="{{ 'order.pagination_aria'|trans }}">
            <a href="{{ path('orders_index', app.request.query.all|merge({page: previousPage})) }}" aria-disabled="{{ orders.page <= 1 ? 'true' : 'false' }}">{{ 'common.previous'|trans }}</a>
            <span class="orders-page-indicator">{{ 'order.page'|trans }} {{ orders.page }} / {{ orders.totalPages() }}</span>
            <a href="{{ path('orders_index', app.request.query.all|merge({page: nextPage})) }}" aria-disabled="{{ orders.page >= orders.totalPages() ? 'true' : 'false' }}">{{ 'common.after'|trans }}</a>
        </nav>
    {% endif %}
</main>
{% endblock %}
