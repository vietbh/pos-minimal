{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'app.home_title'|trans }}{% endblock %}

{% block authenticated_body %}
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <p class="eyebrow">{{ 'app.application'|trans }}</p>
            <h1 id="home-title">{{ 'app.greeting'|trans }}, {{ user.username }}</h1>
            <p class="muted">{{ 'app.home_subtitle'|trans }}</p>
            <div class="home-role-badge" aria-label="{{ 'app.current_role'|trans }}">
                <span>{{ 'app.current_role'|trans }}</span>
                <strong>{{ role_label }}</strong>
            </div>
        </div>
        <nav class="button-row home-hero-actions" aria-label="{{ 'app.primary_actions'|trans }}">
            <a class="button secondary" href="{{ path('app_profile') }}">{{ 'app.profile'|trans }}</a>
            <a class="button secondary" href="{{ path('app_settings') }}">{{ 'app.settings'|trans }}</a>
            {% if can_open_pos %}
                <a class="button primary" href="{{ path('pos') }}">{{ 'navigation.pos'|trans }}</a>
            {% endif %}
        </nav>
    </section>

    <nav class="dashboard-tabs" aria-label="{{ 'app.dashboard_navigation'|trans }}">
        {% for tab in dashboard_navigation.tabs %}
            <a class="dashboard-tab{% if dashboard_navigation.activeTab == tab.key %} is-active{% endif %}"
               href="{{ path('app_home', {'tab': tab.key}) }}"
               {% if dashboard_navigation.activeTab == tab.key %}aria-current="page"{% endif %}>
                {{ tab.label|trans }}
            </a>
        {% endfor %}
    </nav>

    {% if dashboard_navigation.activeTab == 'overview' %}
        {% if dashboard %}
            <section class="home-section" aria-labelledby="today-summary-title">
                <div class="home-section-heading">
                    <div>
                        <p class="eyebrow">{{ 'app.today'|trans }}</p>
                        <h2 id="today-summary-title">{{ 'app.dashboard_today_summary'|trans }}</h2>
                    </div>
                    <a class="home-section-link" href="{{ path('statistics_index') }}">{{ 'app.view_statistics'|trans }}</a>
                </div>

                <div class="dashboard-kpi-grid dashboard-kpi-grid-compact">
                    <article class="dashboard-kpi dashboard-kpi-primary">
                        <span>{{ 'app.sales_today'|trans }}</span>
                        <strong>{{ dashboard.sales.netSales|money_vnd }}</strong>
                        <small>{{ dashboard.sales.qualifyingOrders }} {{ 'app.valid_orders'|trans }}</small>
                    </article>
                    <article class="dashboard-kpi">
                        <span>{{ 'navigation.orders'|trans }}</span>
                        <strong>{{ dashboard.sales.qualifyingOrders }}</strong>
                        <small>{{ 'app.dashboard_completed_orders'|trans }}</small>
                    </article>
                    <article class="dashboard-kpi">
                        <span>{{ 'app.outstanding_debt'|trans }}</span>
                        <strong>{{ dashboard.debt.outstandingAmount|money_vnd }}</strong>
                        <small>{{ dashboard.debt.debtCount }} {{ 'app.debt_records_today'|trans }}</small>
                    </article>
                    <article class="dashboard-kpi{% if dashboard.stock.lowStockProducts > 0 or dashboard.stock.outOfStockProducts > 0 %} dashboard-kpi-warning{% endif %}">
                        <span>{{ 'app.stock_alerts'|trans }}</span>
                        <strong>{{ dashboard.stock.lowStockProducts + dashboard.stock.outOfStockProducts }}</strong>
                        <small>{{ dashboard.stock.lowStockProducts }} {{ 'app.low_stock_separator'|trans }} {{ dashboard.stock.outOfStockProducts }} {{ 'app.out_of_stock_suffix'|trans }}</small>
                    </article>
                </div>
            </section>

            {% if dashboard.stock.lowStockProducts > 0 or dashboard.stock.outOfStockProducts > 0 %}
                <section class="home-alert" aria-labelledby="alert-title">
                    <div>
                        <p class="eyebrow">{{ 'app.attention'|trans }}</p>
                        <h2 id="alert-title">{{ 'app.stock_needs_attention'|trans }}</h2>
                        <p class="muted">{{ 'app.stock_alert_message_prefix'|trans }} {{ dashboard.stock.lowStockProducts }} {{ 'app.stock_alert_message_and'|trans }} {{ dashboard.stock.outOfStockProducts }} {{ 'app.stock_alert_message_out'|trans }}.</p>
                    </div>
                    {% if is_granted('STOCK_VIEW') %}
                        <a class="button secondary" href="{{ path('admin_stock_index') }}">{{ 'app.view_stock'|trans }}</a>
                    {% endif %}
                </section>
            {% endif %}

            <section class="home-section" aria-labelledby="weekly-sales-title">
                <div class="home-section-heading">
                    <div>
                        <p class="eyebrow">{{ 'app.dashboard_last_7_days'|trans }}</p>
                        <h2 id="weekly-sales-title">{{ 'app.dashboard_sales_7_days'|trans }}</h2>
                    </div>
                </div>

                <div class="dashboard-chart-card">
                    <div class="dashboard-chart-summary" aria-label="{{ 'app.dashboard_chart_summary'|trans }}">
                        <div>
                            <span>{{ 'app.dashboard_7_day_total'|trans }}</span>
                            <strong>{{ dashboard.weeklySales.total|money_vnd }}</strong>
                        </div>
                        <div>
                            <span>{{ 'app.dashboard_highest_day'|trans }}</span>
                            <strong>{{ dashboard.weeklySales.highest|money_vnd }}</strong>
                        </div>
                    </div>

                    {% if dashboard.weeklySales.total != '0.00' %}
                        <div class="dashboard-bar-chart" role="img" aria-label="{{ 'app.dashboard_chart_aria'|trans }}">
                            {% for point in dashboard.weeklySales.points %}
                                <div class="dashboard-bar-column">
                                    <div class="dashboard-bar-value">{{ point.displayLabel }}</div>
                                    <div class="dashboard-bar-track" aria-hidden="true">
                                        <span class="dashboard-bar" style="height: {{ point.barPercent }}%"></span>
                                    </div>
                                    <span class="dashboard-bar-label">{{ point.label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="home-empty" role="status">
                            <strong>{{ 'app.dashboard_chart_empty'|trans }}</strong>
                            <span class="muted">{{ 'app.dashboard_chart_empty_help'|trans }}</span>
                        </div>
                    {% endif %}
                </div>
            </section>

            {% include 'application/_dashboard_kpi_goals.html.twig' with {active_kpi_goals: active_kpi_goals} only %}
        {% else %}
            <section class="home-empty home-section" role="status">
                <strong>{{ 'app.dashboard_no_statistics'|trans }}</strong>
                <span class="muted">{{ 'app.dashboard_no_statistics_help'|trans }}</span>
            </section>
        {% endif %}
    {% elseif dashboard_navigation.activeTab == 'operations' %}
        <section class="home-section" aria-labelledby="operations-title">
            <div class="home-section-heading">
                <div>
                    <p class="eyebrow">{{ 'app.operations'|trans }}</p>
                    <h2 id="operations-title">{{ 'app.dashboard_quick_actions'|trans }}</h2>
                </div>
            </div>
            <div class="home-grid home-grid-role">
                {% if can_open_pos %}
                    <a class="home-card home-card-primary" href="{{ path('pos') }}">
                        <span class="home-card-kicker">{{ 'app.main_function'|trans }}</span>
                        <strong>{{ 'navigation.pos'|trans }}</strong>
                        <span>{{ 'app.role_pos_help'|trans }}</span>
                    </a>
                {% endif %}
                {% if is_granted('ORDER_VIEW') %}
                    <a class="home-card" href="{{ path('orders_index') }}">
                        <span class="home-card-kicker">{{ 'app.operations'|trans }}</span>
                        <strong>{{ 'navigation.orders'|trans }}</strong>
                        <span>{{ 'app.manage_orders'|trans }}</span>
                    </a>
                {% endif %}
                {% if is_granted('CUSTOMER_VIEW') %}
                    <a class="home-card" href="{{ path('customers_index') }}">
                        <span class="home-card-kicker">{{ 'app.customers'|trans }}</span>
                        <strong>{{ 'navigation.customers'|trans }}</strong>
                        <span>{{ 'app.manage_customers'|trans }}</span>
                    </a>
                {% endif %}
                {% if is_granted('DEBT_VIEW') %}
                    <a class="home-card" href="{{ path('debts_index') }}">
                        <span class="home-card-kicker">{{ 'app.finance'|trans }}</span>
                        <strong>{{ 'navigation.debt'|trans }}</strong>
                        <span>{{ 'app.manage_debt'|trans }}</span>
                    </a>
                {% endif %}
                {% if is_granted('PRODUCT_VIEW') %}
                    <a class="home-card" href="{{ path('admin_products_index') }}">
                        <span class="home-card-kicker">{{ 'app.catalog'|trans }}</span>
                        <strong>{{ 'navigation.products'|trans }}</strong>
                        <span>{{ 'app.manage_products'|trans }}</span>
                    </a>
                {% endif %}
                {% if is_granted('STOCK_VIEW') %}
                    <a class="home-card" href="{{ path('admin_stock_index') }}">
                        <span class="home-card-kicker">{{ 'app.inventory'|trans }}</span>
                        <strong>{{ 'navigation.stock'|trans }}</strong>
                        <span>{{ 'app.manage_stock'|trans }}</span>
                    </a>
                {% endif %}
            </div>
        </section>
    {% elseif dashboard_navigation.activeTab == 'insights' %}
        {% if dashboard %}
            <section class="home-section" aria-labelledby="insights-title">
                <div class="home-section-heading">
                    <div>
                        <p class="eyebrow">{{ 'app.insights'|trans }}</p>
                        <h2 id="insights-title">{{ 'app.dashboard_sales_7_days'|trans }}</h2>
                    </div>
                    <a class="home-section-link" href="{{ path('statistics_index') }}">{{ 'app.view_statistics'|trans }}</a>
                </div>
                <div class="dashboard-chart-card">
                    <div class="dashboard-chart-summary">
                        <div><span>{{ 'app.dashboard_7_day_total'|trans }}</span><strong>{{ dashboard.weeklySales.total|money_vnd }}</strong></div>
                        <div><span>{{ 'app.dashboard_highest_day'|trans }}</span><strong>{{ dashboard.weeklySales.highest|money_vnd }}</strong></div>
                    </div>
                    {% if dashboard.weeklySales.total != '0.00' %}
                        <div class="dashboard-bar-chart" role="img" aria-label="{{ 'app.dashboard_chart_aria'|trans }}">
                            {% for point in dashboard.weeklySales.points %}
                                <div class="dashboard-bar-column">
                                    <div class="dashboard-bar-value">{{ point.displayLabel }}</div>
                                    <div class="dashboard-bar-track" aria-hidden="true"><span class="dashboard-bar" style="height: {{ point.barPercent }}%"></span></div>
                                    <span class="dashboard-bar-label">{{ point.label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="home-empty" role="status"><strong>{{ 'app.dashboard_chart_empty'|trans }}</strong><span class="muted">{{ 'app.dashboard_chart_empty_help'|trans }}</span></div>
                    {% endif %}
                </div>
            </section>

            {% include 'application/_dashboard_kpi_goals.html.twig' with {active_kpi_goals: active_kpi_goals} only %}
        {% endif %}
    {% elseif dashboard_navigation.activeTab == 'administration' %}
        <section class="home-section" aria-labelledby="administration-title">
            <div class="home-section-heading">
                <div>
                    <p class="eyebrow">{{ 'app.admin_function'|trans }}</p>
                    <h2 id="administration-title">{{ 'app.dashboard_admin_actions'|trans }}</h2>
                </div>
            </div>
            <div class="home-grid home-grid-role">
                {% if is_granted('USER_MANAGE') %}
                    <a class="home-card" href="{{ path('admin_users_index') }}"><span class="home-card-kicker">{{ 'app.admin_function'|trans }}</span><strong>{{ 'navigation.users'|trans }}</strong><span>{{ 'app.dashboard_manage_users'|trans }}</span></a>
                {% endif %}
                {% if is_granted('PAYMENT_BANK_ACCOUNT_MANAGE') %}
                    <a class="home-card" href="{{ path('admin_payment_accounts') }}"><span class="home-card-kicker">{{ 'app.admin_function'|trans }}</span><strong>{{ 'navigation.payments'|trans }}</strong><span>{{ 'app.manage_payment_accounts'|trans }}</span></a>
                {% endif %}
                {% if is_granted('SALES_POINT_MANAGE') %}
                    <a class="home-card" href="{{ path('admin_sales_points') }}"><span class="home-card-kicker">{{ 'app.admin_function'|trans }}</span><strong>{{ 'app.dashboard_sales_points'|trans }}</strong><span>{{ 'app.manage_sales_points'|trans }}</span></a>
                {% endif %}
                {% if is_granted('STATISTICS_VIEW') %}
                    <a class="home-card" href="{{ path('statistics_index') }}"><span class="home-card-kicker">{{ 'app.insights'|trans }}</span><strong>{{ 'navigation.statistics'|trans }}</strong><span>{{ 'app.view_reports'|trans }}</span></a>
                {% endif %}
                {% if is_granted('ROOT_ANALYTICS_VIEW') %}
                    <a class="home-card" href="{{ path('root_analytics') }}"><span class="home-card-kicker">{{ 'app.admin_function'|trans }}</span><strong>{{ 'navigation.root_analytics'|trans }}</strong><span>{{ 'app.dashboard_root_analytics'|trans }}</span></a>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}
