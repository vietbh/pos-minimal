{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'app.profile_title'|trans }} · Mobile POS{% endblock %}

{% block authenticated_body %}
    <section class="app-header" aria-labelledby="profile-title">
        <div>
            <p class="eyebrow">{{ 'app.account'|trans }}</p>
            <h1 id="profile-title">{{ 'app.profile_title'|trans }}</h1>
            <p class="muted">{{ 'app.profile_help'|trans }}</p>
        </div>
        <nav class="button-row" aria-label="{{ 'app.account'|trans }}">
            <a class="button primary" href="{{ path('app_settings') }}">{{ 'app.settings_title'|trans }}</a>
        </nav>
    </section>

    <div class="profile-layout">
        <section class="form-card profile-card" aria-labelledby="profile-info-title">
            <div class="section-heading">
                <h2 id="profile-info-title">{{ 'app.basic_info'|trans }}</h2>
                <p class="muted">{{ 'app.username_help'|trans }}</p>
            </div>

            <form method="post" action="{{ path('app_profile') }}" class="profile-form">
                <input type="hidden" name="_token" value="{{ csrf_token('profile_settings') }}">

                <label for="profile-username">
                    {{ 'app.username'|trans }}
                    <input
                        id="profile-username"
                        name="username"
                        type="text"
                        value="{{ user.username }}"
                        autocomplete="username"
                        maxlength="180"
                        required
                    >
                </label>

                <div class="profile-readonly-grid">
                    <div>
                        <span class="profile-label">{{ 'app.role'|trans }}</span>
                        <strong>{{ user.roles|join(', ') }}</strong>
                    </div>
                    <div>
                        <span class="profile-label">{{ 'common.status'|trans }}</span>
                        <strong>{{ user.active ? 'common.active'|trans : 'app.locked'|trans }}</strong>
                    </div>
                </div>

                <button class="button primary" type="submit">{{ 'app.save_info'|trans }}</button>
            </form>
        </section>

        <section class="form-card profile-card" aria-labelledby="display-title">
            <div class="section-heading">
                <h2 id="display-title">{{ 'app.font_size'|trans }}</h2>
                <p class="muted">{{ 'app.font_help'|trans }}</p>
            </div>

            <form method="post" action="{{ path('app_profile') }}" class="profile-form">
                <input type="hidden" name="_token" value="{{ csrf_token('profile_settings') }}">
                <input type="hidden" name="username" value="{{ user.username }}">

                <fieldset class="font-size-options">
                    <legend class="sr-only">{{ 'app.choose_font'|trans }}</legend>
                    {% set font_labels = {'small': 'app.font_small'|trans, 'medium': 'app.font_medium'|trans, 'large': 'app.font_large'|trans} %}
                    {% for size in font_sizes %}
                        <label class="font-size-option{% if user.fontSize == size %} is-selected{% endif %}">
                            <input
                                type="radio"
                                name="font_size"
                                value="{{ size }}"
                                {% if user.fontSize == size %}checked{% endif %}
                            >
                            <span class="font-size-preview font-size-preview-{{ size }}">Aa</span>
                            <span>
                                <strong>{{ font_labels[size] }}</strong>
                                <small>{{ size == 'small' ? ('app.font_small'|trans) : (size == 'large' ? ('app.font_large'|trans) : ('app.font_medium'|trans)) }}</small>
                            </span>
                        </label>
                    {% endfor %}
                </fieldset>

                <button class="button primary" type="submit">{{ 'app.save_font'|trans }}</button>
            </form>
        </section>
    </div>

    {% if can_manage_users %}
        <section class="form-card profile-card role-management-card" aria-labelledby="role-management-title">
            <div class="section-heading">
                <h2 id="role-management-title">{{ 'app.user_management'|trans }}</h2>
                <p class="muted">{{ 'app.user_management_help'|trans }}</p>
            </div>

            <div class="user-management-list">
                {% for managed_user in managed_users %}
                    {% set is_self = managed_user.id == user.id %}
                    {% set is_root_target = 'ROLE_ROOT' in managed_user.roles %}
                    {% set primary_role = is_root_target ? 'ROLE_ROOT' : ('ROLE_ADMIN' in managed_user.roles ? 'ROLE_ADMIN' : 'ROLE_USER') %}
                    <article class="user-management-card">
                        <div class="user-management-card__identity">
                            <strong>{{ managed_user.username }}</strong>
                            <span class="muted">{{ managed_user.active ? 'common.active'|trans : 'app.locked'|trans }}</span>
                            {% if is_self %}
                                <span class="role-badge role-badge--self">{{ 'app.current_account'|trans }}</span>
                            {% endif %}
                        </div>

                        {% if is_self %}
                            <div class="user-management-readonly">
                                <span class="profile-label">{{ 'app.role'|trans }}</span>
                                <strong>{{ primary_role }}</strong>
                                <small class="muted">{{ 'app.role_self_locked'|trans }}</small>
                            </div>
                        {% elseif is_root_target and not can_manage_root %}
                            <div class="user-management-readonly">
                                <span class="profile-label">{{ 'app.role'|trans }}</span>
                                <strong>ROLE_ROOT</strong>
                                <small class="muted">{{ 'app.role_root_only'|trans }}</small>
                            </div>
                        {% else %}
                            <form method="post" action="{{ path('app_profile') }}" class="role-management-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_role_management') }}">
                                <input type="hidden" name="role_target_id" value="{{ managed_user.id }}">
                                <label>
                                    <span class="profile-label">{{ 'app.role'|trans }}</span>
                                    <select name="role" aria-label="{{ 'app.role_for_user'|trans }} {{ managed_user.username }}">
                                        <option value="ROLE_USER"{% if primary_role == 'ROLE_USER' %} selected{% endif %}>ROLE_USER</option>
                                        <option value="ROLE_ADMIN"{% if primary_role == 'ROLE_ADMIN' %} selected{% endif %}>ROLE_ADMIN</option>
                                        {% if can_manage_root %}
                                            <option value="ROLE_ROOT"{% if primary_role == 'ROLE_ROOT' %} selected{% endif %}>ROLE_ROOT</option>
                                        {% endif %}
                                    </select>
                                </label>
                                <button class="button primary" type="submit">{{ 'app.save_role'|trans }}</button>
                            </form>
                        {% endif %}
                    </article>
                {% else %}
                    <div class="empty-state">{{ 'app.no_users_to_manage'|trans }}</div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="form-card profile-card" aria-labelledby="password-title">
        <div class="section-heading">
            <h2 id="password-title">{{ 'app.change_password'|trans }}</h2>
            <p class="muted">{{ 'app.change_password_help'|trans }}</p>
        </div>
        <form method="post" action="{{ path('app_profile') }}" class="profile-form" data-controller="change-password" data-action="submit->change-password#submit">
            <input type="hidden" name="_token" value="{{ csrf_token('profile_settings') }}">
            <div class="login-field">
                <label for="current-password" class="login-label">{{ 'app.current_password'|trans }}</label>
                <div class="login-password-wrap">
                    <input id="current-password" class="login-input login-input-password" type="password" name="current_password" autocomplete="current-password" required data-change-password-target="current" />
                    <button type="button" class="login-password-toggle" data-change-password-target="currentToggle" data-action="click->change-password#toggleCurrent" data-show-label="{{ 'auth.login.show_password'|trans }}" data-hide-label="{{ 'auth.login.hide_password'|trans }}" aria-label="{{ 'auth.login.show_password'|trans }}" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button>
                </div>
            </div>
            <div class="login-field">
                <label for="new-password" class="login-label">{{ 'app.new_password'|trans }}</label>
                <div class="login-password-wrap">
                    <input id="new-password" class="login-input login-input-password" type="password" name="new_password" autocomplete="new-password" minlength="8" required data-change-password-target="new" />
                    <button type="button" class="login-password-toggle" data-change-password-target="newToggle" data-action="click->change-password#toggleNew" data-show-label="{{ 'auth.login.show_password'|trans }}" data-hide-label="{{ 'auth.login.hide_password'|trans }}" aria-label="{{ 'auth.login.show_password'|trans }}" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button>
                </div>
            </div>
            <div class="login-field">
                <label for="confirm-password" class="login-label">{{ 'app.confirm_password'|trans }}</label>
                <div class="login-password-wrap">
                    <input id="confirm-password" class="login-input login-input-password" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required data-change-password-target="confirm" />
                    <button type="button" class="login-password-toggle" data-change-password-target="confirmToggle" data-action="click->change-password#toggleConfirm" data-show-label="{{ 'auth.login.show_password'|trans }}" data-hide-label="{{ 'auth.login.hide_password'|trans }}" aria-label="{{ 'auth.login.show_password'|trans }}" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button>
                </div>
            </div>
            <button class="button primary" type="submit" data-change-password-target="submit">{{ 'app.change_password_action'|trans }}</button>
        </form>
    </section>

    <section class="form-card profile-card" aria-labelledby="security-title">
        <div class="section-heading">
            <h2 id="security-title">{{ 'app.security'|trans }}</h2>
            <p class="muted">{{ 'app.remember_help'|trans }}</p>
        </div>
        <div class="profile-security-note">
            <strong>{{ 'app.current_session'|trans }}</strong>
            <span>{{ 'app.logout_help'|trans }}</span>
        </div>
        <a class="button" href="{{ path('logout') }}">{{ 'app.logout'|trans }}</a>
    </section>
{% endblock %}
