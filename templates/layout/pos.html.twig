{% extends 'base.html.twig' %}

{% block body %}
    <a class="skip-link" href="#main-content">{{ 'navigation.skip_to_content'|trans }}</a>
    <div class="app-frame pos-frame" data-controller="mobile-ux">
        <aside class="desktop-sidebar" aria-label="{{ 'navigation.primary'|trans }}">
            <a class="sidebar-brand" href="{{ path('app_home') }}" aria-label="{{ 'app.brand_home'|trans }}">
                <span class="app-brand-mark" aria-hidden="true">{{ 'customer.pos'|trans }}</span>
                <span><strong>{{ 'app.brand'|trans }}</strong><small>{{ 'app.sales_workspace'|trans }}</small></span>
            </a>

            <nav class="sidebar-nav" aria-label="{{ 'navigation.primary'|trans }}">
                <p class="sidebar-label">{{ 'navigation.workspace'|trans }}</p>
                <a class="sidebar-pos" href="{{ path('pos') }}" aria-current="page"><span aria-hidden="true">＋</span><span>{{ 'navigation.pos'|trans }}</span></a>
                <a href="{{ path('app_home') }}"><span aria-hidden="true">⌂</span><span>{{ 'navigation.home'|trans }}</span></a>
                {% if is_granted('ORDER_VIEW') %}<a href="{{ path('orders_index') }}"><span aria-hidden="true">▤</span><span>{{ 'navigation.orders'|trans }}</span></a>{% endif %}
                {% if is_granted('CUSTOMER_VIEW') %}<a href="{{ path('customers_index') }}"><span aria-hidden="true">♙</span><span>{{ 'navigation.customers'|trans }}</span></a>{% endif %}
                {% if is_granted('PRODUCT_VIEW') %}<a href="{{ path('admin_products_index') }}"><span aria-hidden="true">□</span><span>{{ 'navigation.products'|trans }}</span></a>{% endif %}
                {% if is_granted('STOCK_VIEW') %}<a href="{{ path('admin_stock_index') }}"><span aria-hidden="true">▥</span><span>{{ 'navigation.stock'|trans }}</span></a>{% endif %}
                {% if is_granted('DEBT_VIEW') %}<a href="{{ path('debts_index') }}"><span aria-hidden="true">₫</span><span>{{ 'navigation.debt'|trans }}</span></a>{% endif %}
            </nav>

            <div class="sidebar-footer">
                <a href="{{ path('app_profile') }}">
                    <span class="sidebar-avatar" aria-hidden="true">{{ app.user.username|default('U')|slice(0,1)|upper }}</span>
                    <span class="sidebar-user"><strong>{{ app.user.username|default('User') }}</strong><small>{{ 'app.account_settings'|trans }}</small></span>
                </a>
                <form method="post" action="{{ path('logout') }}" class="sidebar-logout-form">
                    <button class="sidebar-logout" type="submit">{{ 'auth.logout'|trans }}</button>
                </form>
            </div>
        </aside>

        <div class="app-content-shell">
            <header class="mobile-topbar pos-mobile-topbar">
                <a class="app-brand" href="{{ path('app_home') }}" aria-label="{{ 'app.brand_home'|trans }}">
                    <span class="app-brand-mark" aria-hidden="true">{{ 'customer.pos'|trans }}</span>
                    <span>{{ 'navigation.pos'|trans }}</span>
                </a>
                <a class="button" href="{{ path('app_home') }}">{{ 'pos.close'|trans }}</a>
            </header>

            {% include 'shared/_flashes.html.twig' %}

            <main class="app-main pos-main" id="main-content" tabindex="-1">
                {% block pos_body %}{% endblock %}
            </main>
        </div>

        <nav class="mobile-bottom-nav" aria-label="{{ 'navigation.quick'|trans }}">
            <a href="{{ path('app_home') }}"><span aria-hidden="true">⌂</span><small>{{ 'navigation.home'|trans }}</small></a>
            {% if is_granted('ORDER_VIEW') %}<a href="{{ path('orders_index') }}"><span aria-hidden="true">▤</span><small>{{ 'navigation.orders'|trans }}</small></a>{% endif %}
            <a class="mobile-bottom-nav-primary" href="{{ path('pos') }}" aria-current="page"><span aria-hidden="true">＋</span><small>{{ 'navigation.pos'|trans }}</small></a>
            {% if is_granted('PRODUCT_VIEW') %}<a href="{{ path('admin_products_index') }}"><span aria-hidden="true">□</span><small>{{ 'navigation.products'|trans }}</small></a>{% endif %}
            <a href="{{ path('app_profile') }}"><span aria-hidden="true">●</span><small>{{ 'navigation.account'|trans }}</small></a>
        </nav>
    </div>
{% endblock %}
