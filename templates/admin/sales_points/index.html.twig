{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'pos.admin.sales_points'|trans }}{% endblock %}
{% block authenticated_body %}
<div class="admin-workspace" data-controller="sales-point-form">
<header class="admin-toolbar"><div><p class="eyebrow">{{ 'pos.admin.pos_setup'|trans }}</p><h1>{{ 'pos.admin.sales_points'|trans }}</h1><p>{{ 'pos.admin.sales_points_help'|trans }}</p></div><div class="admin-toolbar__actions"><a class="button" href="{{ path('pos') }}">{{ 'customer.pos'|trans }}</a></div></header>
{% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}
{% if sales_points %}<div class="admin-card-grid">{% for point in sales_points %}<article class="admin-card"><div class="admin-card__header"><div><h2 class="admin-card__title">{{ point.name }}</h2><div class="admin-card__meta"><span>{{ point.code }}</span><span>{{ point.type.value == 'TABLE' ? 'pos.admin.sales_point_type_table'|trans : 'pos.admin.sales_point_type_pos'|trans }}</span>{% if point.group %}<span>{{ point.group.name }}</span>{% endif %}</div></div>{% if point.active %}<span class="admin-status admin-status--success">{{ 'common.active'|trans }}</span>{% else %}<span class="admin-status admin-status--neutral">{{ 'common.disabled'|trans }}</span>{% endif %}</div><div class="admin-actions"><a class="button" href="{{ path('admin_sales_points',{edit:point.id}) }}">{{ 'common.edit'|trans }}</a><form method="post" action="{{ path('admin_sales_point_toggle',{id:point.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_sales_point_toggle') }}"><button class="button" type="submit">{{ point.active ? 'common.disable'|trans : 'common.enable'|trans }}</button></form></div></article>{% endfor %}</div>{% else %}<div class="admin-empty">{{ 'pos.admin.no_sales_points'|trans }}</div>{% endif %}
<form class="admin-form" method="post"><h2>{{ edit_sales_point ? 'pos.admin.edit_sales_point'|trans : 'pos.admin.add_sales_point'|trans }}</h2><input type="hidden" name="_token" value="{{ csrf_token }}">{% if edit_sales_point %}<input type="hidden" name="id" value="{{ edit_sales_point.id }}">{% endif %}<label>{{ 'pos.admin.code'|trans }}<div class="input-with-action"><input name="code" required maxlength="50" value="{{ edit_sales_point ? edit_sales_point.code : '' }}" autocomplete="off" data-sales-point-form-target="code"><button class="button" type="button" data-action="sales-point-form#generateCode">{{ 'pos.admin.generate_code'|trans }}</button></div><small class="admin-help">{{ 'pos.admin.sales_point_code_help'|trans }}</small></label><label>{{ 'pos.admin.display_name'|trans }}<input name="name" required maxlength="120" value="{{ edit_sales_point ? edit_sales_point.name : '' }}"></label><label>{{ 'pos.admin.type'|trans }}<select name="type" data-sales-point-form-target="type"><option value="POS" {{ edit_sales_point and edit_sales_point.type.value == 'POS' ? 'selected' }}>{{ 'pos.admin.sales_point_type_pos'|trans }}</option><option value="TABLE" {{ edit_sales_point and edit_sales_point.type.value == 'TABLE' ? 'selected' }}>{{ 'pos.admin.sales_point_type_table'|trans }}</option></select></label><label>{{ 'pos.admin.group'|trans }}<select name="groupId"><option value="0">{{ 'pos.admin.none'|trans }}</option>{% for group in groups %}<option value="{{ group.id }}" {{ edit_sales_point and edit_sales_point.group and edit_sales_point.group.id == group.id ? 'selected' }}>{{ group.name }}</option>{% endfor %}</select></label><label><input type="checkbox" name="isActive" value="1" {% if not edit_sales_point or edit_sales_point.active %}checked{% endif %}> {{ 'common.active'|trans }}</label><button class="button primary" type="submit">{{ edit_sales_point ? 'pos.admin.save_changes'|trans : 'pos.admin.add_sales_point'|trans }}</button></form>
</div>
{% endblock %}
