{% extends 'layout/authenticated.html.twig' %}{% block title %}{{ 'admin.product_categories'|trans }}{% endblock %}{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.catalog'|trans }}</p><h1>{{ 'admin.product_categories'|trans }}</h1><p>{{ 'admin.categories_help'|trans }}</p></div><div class="admin-toolbar__actions"><a class="button" href="{{ path('admin_products_index') }}">{{ 'common.products'|trans }}</a>{% if is_granted('PRODUCT_EDIT') %}<a class="button primary" href="{{ path('admin_product_categories_new') }}">{{ 'admin.new_category'|trans }}</a>{% endif %}</div></header>
{% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}
{% if categories is empty %}<div class="admin-empty">{{ 'admin.no_categories'|trans }}</div>{% else %}<div class="admin-card-grid">{% for category in categories %}<article class="admin-card"><div class="admin-card__header"><div><h2 class="admin-card__title">{{ category.name }}</h2><div class="admin-card__meta">{{ 'admin.category_used'|trans }}</div></div>{% if category.isActive %}<span class="admin-status admin-status--success">{{ 'common.active'|trans }}</span>{% else %}<span class="admin-status admin-status--neutral">{{ 'common.inactive'|trans }}</span>{% endif %}</div>{% if is_granted('PRODUCT_EDIT') %}<div class="admin-actions"><a class="button" href="{{ path('admin_product_categories_edit',{id:category.id}) }}">{{ 'common.edit'|trans }}</a><form method="post" action="{{ path('admin_product_categories_toggle',{id:category.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('product_category_state') }}"><button type="submit">{{ category.isActive ? 'Deactivate' : 'Activate' }}</button></form></div>{% endif %}</article>{% endfor %}</div>{% endif %}</div>{% endblock %}
