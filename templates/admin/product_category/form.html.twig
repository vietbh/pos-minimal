{% extends 'layout/authenticated.html.twig' %}{% block title %}{{ category ? 'admin.edit_category'|trans : 'admin.new_category'|trans }}{% endblock %}{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.catalog'|trans }}</p><h1>{{ category ? 'admin.edit_category'|trans : 'admin.new_category'|trans }}</h1></div><div class="admin-toolbar__actions"><a class="button" href="{{ path('admin_product_categories') }}">{{ 'common.back'|trans }}</a></div></header>{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}<form class="admin-form" method="post"><div class="admin-form__group"><h2>{{ 'admin.category_information'|trans }}</h2><label>{{ 'admin.name'|trans }}<input required maxlength="150" name="name" value="{{ name }}" autofocus autocomplete="off"></label></div><input type="hidden" name="_token" value="{{ csrf_token('product_category_form') }}"><div class="admin-form__actions"><button class="primary" type="submit">{{ category ? 'admin.save_changes'|trans : 'admin.create_category_action'|trans }}</button><a class="button" href="{{ path('admin_product_categories') }}">{{ 'common.cancel'|trans }}</a></div></form></div>{% endblock %}
