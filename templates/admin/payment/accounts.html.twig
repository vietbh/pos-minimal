{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'admin.receiving_accounts'|trans }}{% endblock %}
{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.payment_settings'|trans }}</p><h1>{{ 'admin.receiving_accounts'|trans }}</h1><p>{{ 'admin.receiving_accounts_help'|trans }}</p></div><div class="admin-toolbar__actions"><a class="button" href="{{ path('pos') }}">{{ 'customer.pos'|trans }}</a></div></header>
{% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}
{% if accounts is empty %}<div class="admin-empty">{{ 'admin.no_receiving_accounts'|trans }}</div>{% else %}<div class="admin-card-grid">{% for account in accounts %}<article class="admin-card"><div class="admin-card__header"><div><h2 class="admin-card__title">{{ account.bankName }}</h2><div class="admin-card__meta"><span>{{ account.accountNumber }} · {{ account.accountName }}</span><span>{{ 'admin.bank_bin'|trans }} {{ account.bankBin }}</span><span>{{ account.isActive ? 'common.active'|trans : 'common.disabled'|trans }}</span></div></div>{% if account.isActive %}<span class="admin-status admin-status--success">{{ 'common.active'|trans }}</span>{% else %}<span class="admin-status admin-status--neutral">{{ 'common.disabled'|trans }}</span>{% endif %}</div><div class="admin-card__meta"><span>{{ 'admin.transfer_content'|trans }}: {{ account.transferContentTemplate }}</span>{% if account.cassoSubAccountId %}<span>{{ 'admin.casso_subaccount'|trans }}: {{ account.cassoSubAccountId }}</span>{% endif %}</div><div class="admin-actions"><a class="button" href="{{ path('admin_payment_accounts', {edit: account.id}) }}">{{ 'common.edit'|trans }}</a><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_payment_account_toggle') }}"><button type="submit">{{ account.isActive ? 'Disable' : 'Enable' }}</button></form></div></article>{% endfor %}</div>{% endif %}
<form class="admin-form" method="post"><div class="admin-form__group"><h2>{{ edit_account ? 'admin.edit_account'|trans : 'admin.add_account'|trans }}</h2><p class="admin-help">{{ 'admin.only_payment_info'|trans }}</p></div><input type="hidden" name="_token" value="{{ csrf_token('admin_payment_account') }}">{% if edit_account %}<input type="hidden" name="id" value="{{ edit_account.id }}">{% endif %}{% if bank_list_error %}<div class="flash error" role="alert">{{ bank_list_error }}</div>{% endif %}
<label for="payment-bank-select">{{ 'admin.bank'|trans }}<select name="bankBin" id="payment-bank-select" required {% if not banks %}disabled{% endif %}><option value="">{{ 'admin.select_bank'|trans }}</option>{% for bank in banks %}<option value="{{ bank.bin }}" data-bank-name="{{ bank.name|e('html_attr') }}" data-short-name="{{ bank.shortName|e('html_attr') }}" {% if edit_account and edit_account.bankBin == bank.bin %}selected{% endif %}>{{ bank.shortName ?: bank.code }} — {{ bank.name }}</option>{% endfor %}</select></label>
<label for="payment-bank-name-display">{{ 'admin.bank_name'|trans }}<input id="payment-bank-name-display" value="{{ edit_account ? edit_account.bankName : '' }}" readonly></label><label for="payment-bank-bin-display">{{ 'admin.bank_bin'|trans }}<input id="payment-bank-bin-display" value="{{ edit_account ? edit_account.bankBin : '' }}" readonly></label><label for="payment-account-number">{{ 'admin.account_number'|trans }}<input id="payment-account-number" name="accountNumber" value="{{ edit_account ? edit_account.accountNumber : '' }}" required inputmode="numeric" autocomplete="off" placeholder="{{ 'admin.account_number_placeholder'|trans }}"></label><label for="payment-account-name">{{ 'admin.account_name'|trans }}<input id="payment-account-name" name="accountName" value="{{ edit_account ? edit_account.accountName : '' }}" required autocomplete="off" placeholder="{{ 'admin.account_name_placeholder'|trans }}"></label>
<div class="admin-form__group"><strong>{{ 'admin.payment_reference'|trans }}</strong><small class="admin-help">{{ 'admin.payment_reference_help'|trans }}</small></div>
<label for="payment-transfer-template">{{ 'admin.transfer_template'|trans }}<input id="payment-transfer-template" name="transferContentTemplate" value="{{ edit_account ? edit_account.transferContentTemplate : 'Thanh {PAYMENT REFERENCE} BUIHOANGVIET' }}" maxlength="255" required><small class="admin-help">{{ 'admin.transfer_template_help'|trans }}</small></label><label for="payment-qr-template">{{ 'admin.qr_template'|trans }}<select id="payment-qr-template" name="qrTemplate"><option value="compact2" {% if edit_account and edit_account.qrTemplate == 'compact2' %}selected{% endif %}>{{ 'admin.compact2'|trans }}</option><option value="compact" {% if edit_account and edit_account.qrTemplate == 'compact' %}selected{% endif %}>{{ 'admin.compact'|trans }}</option><option value="qr_only" {% if edit_account and edit_account.qrTemplate == 'qr_only' %}selected{% endif %}>{{ 'admin.qr_only'|trans }}</option></select></label><label for="payment-casso-subaccount">{{ 'admin.casso_subaccount'|trans }}<input id="payment-casso-subaccount" name="cassoSubAccountId" value="{{ edit_account ? (edit_account.cassoSubAccountId ?: '') : '' }}" placeholder="{{ 'admin.optional'|trans }}"></label><label><input type="checkbox" name="isActive" value="1" {% if not edit_account or edit_account.isActive %}checked{% endif %}> {{ 'common.active'|trans }}</label><button class="button primary" type="submit" {% if not banks %}disabled{% endif %}>{{ edit_account ? 'admin.save_changes'|trans : 'admin.add_account'|trans }}</button></form></div>
<script>
(() => { const select=document.getElementById('payment-bank-select'); const name=document.getElementById('payment-bank-name-display'); const bin=document.getElementById('payment-bank-bin-display'); if(!select||!name||!bin)return; const sync=()=>{const option=select.selectedOptions[0];name.value=option?.dataset.bankName||'';bin.value=select.value||'';}; select.addEventListener('change',sync);sync();})();
</script>{% endblock %}
