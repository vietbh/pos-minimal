{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'sales_point.title'|trans }} · Mobile POS{% endblock %}

{% block authenticated_body %}
<section class="app-header" aria-labelledby="sales-point-title">
    <div>
        <p class="eyebrow">{{ 'navigation.management'|trans }}</p>
        <h1 id="sales-point-title">{{ 'sales_point.title'|trans }}</h1>
        <p class="muted">{{ 'sales_point.help'|trans }}</p>
    </div>
</section>

<div class="sales-point-admin-grid">
    <section class="form-card" aria-labelledby="sales-point-create-title">
        <div class="section-heading">
            <h2 id="sales-point-create-title">{{ edit_sales_point ? 'sales_point.edit'|trans : 'sales_point.create'|trans }}</h2>
            <p class="muted">{{ 'sales_point.create_help'|trans }}</p>
        </div>
        <form method="post" action="{{ path('admin_sales_point_create') }}" class="profile-form" data-controller="sales-point-form">
            <input type="hidden" name="_token" value="{{ point_csrf_token }}">
            {% if edit_sales_point %}<input type="hidden" name="id" value="{{ edit_sales_point.id }}">{% endif %}
            <label for="sales-point-code">{{ 'sales_point.code'|trans }}
                <div class="input-with-action">
                    <input id="sales-point-code" name="code" maxlength="60" required value="{{ edit_sales_point ? edit_sales_point.code : '' }}" placeholder="POS-01 / TABLE-A1" autocomplete="off">
                    {% if not edit_sales_point %}<button class="button" type="button" data-action="sales-point-form#generateCode">{{ 'sales_point.generate_code'|trans }}</button>{% endif %}
                </div>
            </label>
            <label for="sales-point-name">{{ 'sales_point.name'|trans }}
                <input id="sales-point-name" name="name" maxlength="160" required value="{{ edit_sales_point ? edit_sales_point.name : '' }}" placeholder="{{ 'sales_point.name_placeholder'|trans }}">
            </label>
            <label for="sales-point-type">{{ 'sales_point.type'|trans }}
                <select id="sales-point-type" name="type">
                    {% for type in types %}<option value="{{ type.value }}" {{ edit_sales_point and edit_sales_point.type.value == type.value ? 'selected' : '' }}>{{ type.value == 'TABLE' ? 'sales_point.type_table'|trans : 'sales_point.type_pos'|trans }}</option>{% endfor %}
                </select>
            </label>
            <label for="sales-point-group">{{ 'sales_point.group'|trans }}
                <select id="sales-point-group" name="group_id">
                    <option value="0">{{ 'sales_point.no_group'|trans }}</option>
                    {% for group in sales_point_groups %}<option value="{{ group.id }}" {{ edit_sales_point and edit_sales_point.group and edit_sales_point.group.id == group.id ? 'selected' : '' }}>{{ group.name }}</option>{% endfor %}
                </select>
            </label>
            {% if edit_sales_point %}<label><input type="checkbox" name="is_active" value="1" {% if edit_sales_point.active %}checked{% endif %}> {{ 'common.active'|trans }}</label>{% endif %}
            <button class="button primary" type="submit">{{ edit_sales_point ? 'sales_point.save_button'|trans : 'sales_point.create_button'|trans }}</button>
            {% if edit_sales_point %}<a class="button" href="{{ path('admin_sales_points') }}">{{ 'common.cancel'|trans }}</a>{% endif %}
        </form>
    </section>

    <section class="form-card" aria-labelledby="sales-point-group-title">
        <div class="section-heading">
            <h2 id="sales-point-group-title">{{ edit_sales_point_group ? 'sales_point.group_edit'|trans : 'sales_point.group_create'|trans }}</h2>
            <p class="muted">{{ 'sales_point.group_help'|trans }}</p>
        </div>
        <form method="post" action="{{ path('admin_sales_point_group_create') }}" class="profile-form" data-controller="sales-point-form">
            <input type="hidden" name="_token" value="{{ group_csrf_token }}">
            {% if edit_sales_point_group %}<input type="hidden" name="id" value="{{ edit_sales_point_group.id }}">{% endif %}
            <label for="sales-point-group-code">{{ 'sales_point.group_code'|trans }}
                <div class="input-with-action"><input id="sales-point-group-code" name="code" maxlength="50" required value="{{ edit_sales_point_group ? edit_sales_point_group.code : '' }}" placeholder="FLOOR-1" autocomplete="off" data-sales-point-form-target="groupCode">{% if not edit_sales_point_group %}<button class="button" type="button" data-action="sales-point-form#generateGroupCode">{{ 'sales_point.generate_code'|trans }}</button>{% endif %}</div>
            </label>
            <label for="sales-point-group-name">{{ 'sales_point.group_name'|trans }}
                <input id="sales-point-group-name" name="name" maxlength="120" required value="{{ edit_sales_point_group ? edit_sales_point_group.name : '' }}" placeholder="Tầng 1 / Quầy thu ngân">
            </label>
            <label for="sales-point-group-sort">{{ 'sales_point.sort_order'|trans }}
                <input id="sales-point-group-sort" name="sort_order" type="number" value="{{ edit_sales_point_group ? edit_sales_point_group.sortOrder : 0 }}" min="0" step="1">
            </label>
            {% if edit_sales_point_group %}<label><input type="checkbox" name="is_active" value="1" {% if edit_sales_point_group.active %}checked{% endif %}> {{ 'common.active'|trans }}</label>{% endif %}
            <button class="button" type="submit">{{ edit_sales_point_group ? 'sales_point.save_button'|trans : 'sales_point.group_create_button'|trans }}</button>
            {% if edit_sales_point_group %}<a class="button" href="{{ path('admin_sales_points') }}">{{ 'common.cancel'|trans }}</a>{% endif %}
        </form>
    </section>
</div>

<section class="form-card sales-point-list-card" aria-labelledby="sales-point-group-list-title">
    <div class="section-heading">
        <h2 id="sales-point-group-list-title">{{ 'sales_point.group_list'|trans }}</h2>
        <p class="muted">{{ 'sales_point.group_list_help'|trans }}</p>
    </div>
    <div class="sales-point-list">
        {% for group in sales_point_groups %}
            <article class="sales-point-item">
                <div>
                    <div class="sales-point-item-title"><strong>{{ group.name }}</strong> <span class="status-badge">{{ group.code }}</span></div>
                    <p class="muted">{{ 'sales_point.sort_order'|trans }}: {{ group.sortOrder }}</p>
                </div>
                <div class="admin-actions">
                    <a class="button" href="{{ path('admin_sales_points', {edit_group: group.id}) }}">{{ 'common.edit'|trans }}</a>
                    <form method="post" action="{{ path('admin_sales_point_group_toggle', {id: group.id}) }}">
                        <input type="hidden" name="_token" value="{{ group_state_csrf_token }}">
                        <button class="button{% if group.active %} danger{% endif %}" type="submit">{{ group.active ? 'sales_point.deactivate'|trans : 'sales_point.activate'|trans }}</button>
                    </form>
                </div>
            </article>
        {% else %}
            <p class="statistics-empty">{{ 'sales_point.group_empty'|trans }}</p>
        {% endfor %}
    </div>
</section>

<section class="form-card sales-point-list-card" aria-labelledby="sales-point-list-title">
    <div class="section-heading">
        <h2 id="sales-point-list-title">{{ 'sales_point.list'|trans }}</h2>
        <p class="muted">{{ 'sales_point.list_help'|trans }}</p>
    </div>
    <div class="sales-point-list">
        {% for point in sales_points %}
            <article class="sales-point-item">
                <div>
                    <div class="sales-point-item-title"><strong>{{ point.name }}</strong> <span class="status-badge">{{ point.type.value == 'TABLE' ? 'sales_point.type_table'|trans : 'sales_point.type_pos'|trans }}</span></div>
                    <p class="muted">{{ point.code }}{% if point.group %} · {{ point.group.name }}{% endif %}</p>
                </div>
                <div class="admin-actions">
                    <a class="button" href="{{ path('admin_sales_points', {edit: point.id}) }}">{{ 'common.edit'|trans }}</a>
                    <form method="post" action="{{ path('admin_sales_point_toggle', {id: point.id}) }}">
                        <input type="hidden" name="_token" value="{{ point_state_csrf_token }}">
                        <button class="button{% if point.active %} danger{% endif %}" type="submit">{{ point.active ? 'sales_point.deactivate'|trans : 'sales_point.activate'|trans }}</button>
                    </form>
                </div>
            </article>
        {% else %}
            <p class="statistics-empty">{{ 'sales_point.empty'|trans }}</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
