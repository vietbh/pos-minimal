{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'common.stock'|trans }}{% endblock %}
{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.inventory'|trans }}</p><h1>{{ 'common.stock'|trans }}</h1><p id="stock-list-help">{{ 'admin.stock_products_count'|trans({'%count%': pagination.total}) }}</p></div></header>
<form class="admin-filter" method="get" aria-describedby="stock-list-help"><div class="admin-filter__fields"><label for="stock-search">{{ 'admin.search_product'|trans }}<input id="stock-search" name="q" value="{{ q }}" placeholder="{{ 'admin.name_or_sku'|trans }}" autocomplete="off"></label></div><div class="admin-filter__actions"><button class="primary" type="submit">{{ 'common.search'|trans }}</button>{% if q %}<a class="button" href="{{ path('admin_stock_index') }}">{{ 'common.clear'|trans }}</a>{% endif %}</div></form>
{% if products is empty %}<div class="admin-empty">{% if q %}{{ 'admin.no_products_found'|trans }}{% else %}{{ 'admin.no_active_products'|trans }}{% endif %}</div>{% else %}<div class="admin-card-grid">{% for product in products %}<article class="admin-card"><div class="admin-card__header"><div><h2 class="admin-card__title"><a href="{{ path('admin_stock_show',{productId:product.id}) }}">{{ product.name }}</a></h2><div class="admin-card__meta">{{ product.sku ?: ('admin.no_sku'|trans) }}{% if product.unit %} · {{ product.unit }}{% endif %}</div></div>{% if product.stockQuantity <= product.lowStockThreshold %}<span class="admin-status admin-status--warning">{{ 'admin.low_stock'|trans }}</span>{% else %}<span class="admin-status admin-status--success">{{ 'admin.stock_ok'|trans }}</span>{% endif %}</div><div class="admin-card__facts"><div class="admin-fact"><small>{{ 'admin.current_stock'|trans }}</small><strong>{{ product.stockQuantity }}</strong></div><div class="admin-fact"><small>{{ 'admin.low_threshold'|trans }}</small><strong>{{ product.lowStockThreshold }}</strong></div></div><div class="admin-actions"><a class="button" href="{{ path('admin_stock_show',{productId:product.id}) }}">{{ 'admin.view_stock'|trans }}</a></div></article>{% endfor %}</div>{% endif %}
{% if pagination.totalPages > 1 %}<nav class="pagination" aria-label="{{ 'admin.stock_pagination'|trans }}"><a class="button{% if pagination.page <= 1 %} disabled{% endif %}"{% if pagination.page > 1 %} href="{{ path('admin_stock_index',{q:q,page:pagination.page-1}) }}"{% endif %}>{{ 'common.previous'|trans }}</a><span aria-current="page">{{ 'admin.page_of'|trans({'%page%': pagination.page, '%total%': pagination.totalPages}) }}</span><a class="button{% if pagination.page >= pagination.totalPages %} disabled{% endif %}"{% if pagination.page < pagination.totalPages %} href="{{ path('admin_stock_index',{q:q,page:pagination.page+1}) }}"{% endif %}>{{ 'common.next'|trans }}</a></nav>{% endif %}</div>{% endblock %}
