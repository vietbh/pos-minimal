{% extends 'base.html.twig' %}{% block title %}Stock{% endblock %}{% block body %}<div class="app-shell"><header class="app-header"><h1>Stock</h1><nav><a href="{{ path('admin_products_index') }}">Products</a> <a href="{{ path('customers_index') }}">Customers</a></nav></header><form class="search-bar" method="get"><label for="stock-search">Search product</label><input id="stock-search" name="q" value="{{ q }}" placeholder="Name or SKU"><button>Search</button></form>{% if q == '' %}<div class="empty-state">Search a product to inspect stock.</div>{% elseif products is empty %}<div class="empty-state">No products found.</div>{% else %}<div class="card-list">{% for product in products %}<a class="card" href="{{ path('admin_stock_show',{productId:product.id}) }}"><div><strong>{{ product.name }}</strong><small>{{ product.sku ?: 'No SKU' }}</small></div><strong>{{ product.stockQuantity }}</strong></a>{% endfor %}</div>{% endif %}</div>{% endblock %}
