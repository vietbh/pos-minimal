{% extends 'base.html.twig' %}{% block title %}Stock — {{ product.name }}{% endblock %}{% block body %}<div class="app-shell"><header class="app-header"><div><h1>Stock</h1><strong>{{ product.name }}</strong></div><a href="{{ path('admin_stock_index') }}">Back</a></header>{% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}<section class="stats"><div><small>Current stock</small><strong>{{ product.stockQuantity }}</strong></div><div><small>Low threshold</small><strong>{{ product.lowStockThreshold }}</strong></div></section>{% if is_granted('STOCK_ADJUST') %}<form class="form-card" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_adjust') }}"><input type="hidden" name="idempotencyKey" value="{{ random() }}-{{ product.id }}"><label>Quantity change<input type="number" name="quantityChange" required></label><label>Reason<input name="reason"></label><button class="primary">Confirm adjustment</button></form>{% endif %}<h2>History</h2><div class="table-scroll"><table><thead><tr><th>Date</th><th>Type</th><th>Before</th><th>Change</th><th>After</th></tr></thead><tbody>{% for m in movements %}<tr><td>{{ m.createdAt|date('Y-m-d H:i') }}</td><td>{{ m.type.value }}</td><td>{{ m.quantityBefore }}</td><td>{{ m.quantityChange }}</td><td>{{ m.quantityAfter }}</td></tr>{% else %}<tr><td colspan="5">No movements.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
