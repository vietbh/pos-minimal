{% extends 'layout/authenticated.html.twig' %}{% block title %}{{ 'common.stock'|trans }} — {{ product.name }}{% endblock %}{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.inventory'|trans }}</p><h1>{{ 'common.stock'|trans }}</h1><p>{{ product.name }}</p></div><div class="admin-toolbar__actions"><a class="button" href="{{ path('admin_stock_index') }}">{{ 'admin.back_to_stock'|trans }}</a><a class="button" href="{{ path('admin_products_show',{id:product.id}) }}">{{ 'common.product'|trans }}</a></div></header>
{% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}
<section class="admin-summary" aria-label="{{ 'admin.stock_summary'|trans }}"><div class="admin-summary__item"><span>{{ 'admin.current_stock'|trans }}</span><strong>{{ product.stockQuantity }}</strong></div><div class="admin-summary__item"><span>{{ 'admin.low_threshold'|trans }}</span><strong>{{ product.lowStockThreshold }}</strong></div><div class="admin-summary__item"><span>{{ 'admin.stock_status'|trans }}</span><strong class="admin-status {{ product.stockQuantity <= product.lowStockThreshold ? 'admin-status--warning' : 'admin-status--success' }}">{% if product.stockQuantity <= product.lowStockThreshold %}{{ 'admin.low_stock'|trans }}{% else %}{{ 'admin.stock_ok'|trans }}{% endif %}</strong></div></section>
{% if is_granted('PRODUCT_EDIT') %}<form class="admin-form" method="post" action="{{ path('admin_stock_threshold',{productId:product.id}) }}" aria-describedby="threshold-help"><div class="admin-form__group"><h2>{{ 'admin.low_stock_threshold'|trans }}</h2><label for="stock-threshold">{{ 'admin.threshold'|trans }}<input id="stock-threshold" type="number" name="lowStockThreshold" value="{{ product.lowStockThreshold }}" min="0" step="1" required></label><p class="admin-help" id="threshold-help">{{ 'admin.threshold_help'|trans }}</p></div><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_threshold') }}"><button class="primary" type="submit">{{ 'admin.update_threshold'|trans }}</button></form>{% endif %}
{% if is_granted('STOCK_ADJUST') %}<form class="admin-form" method="post" action="{{ path('admin_stock_adjust',{productId:product.id}) }}" data-controller="stock-adjust" data-action="submit->stock-adjust#submit" aria-describedby="stock-adjust-help"><div class="admin-form__group"><h2>{{ 'admin.adjust_stock'|trans }}</h2><label for="stock-quantity-change">{{ 'admin.quantity_change'|trans }}<input id="stock-quantity-change" type="number" name="quantityChange" required></label><label for="stock-adjust-reason">{{ 'common.reason'|trans }}<input id="stock-adjust-reason" name="reason" placeholder="{{ 'admin.optional'|trans }}"></label><p class="admin-help" id="stock-adjust-help">{{ 'admin.adjust_help'|trans }}</p></div><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_adjust') }}"><input type="hidden" name="idempotencyKey" value="{{ random() }}-{{ product.id }}"><button class="primary" type="submit" data-stock-adjust-target="submit">{{ 'admin.confirm_adjustment'|trans }}</button></form>{% endif %}
<section class="admin-section"><h2>{{ 'admin.stock_history'|trans }}</h2><div class="admin-table-wrap"><table class="admin-table"><caption class="visually-hidden">{{ 'admin.stock_history'|trans }}</caption><thead><tr><th scope="col">{{ 'common.date'|trans }}</th><th scope="col">{{ 'common.type'|trans }}</th><th scope="col">{{ 'common.before'|trans }}</th><th scope="col">{{ 'common.change'|trans }}</th><th scope="col">{{ 'common.after'|trans }}</th><th scope="col">{{ 'common.reason'|trans }}</th></tr></thead><tbody>{% for m in movements %}<tr><td>{{ m.createdAt|date('Y-m-d H:i') }}</td><td>{{ m.type.value }}</td><td>{{ m.quantityBefore }}</td><td>{{ m.quantityChange }}</td><td>{{ m.quantityAfter }}</td><td>{{ m.reason ?: '—' }}</td></tr>{% else %}<tr><td colspan="6">{{ 'admin.no_movements'|trans }}</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}
