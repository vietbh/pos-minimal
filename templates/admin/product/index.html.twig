{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'common.products'|trans }}{% endblock %}
{% block authenticated_body %}
<div class="admin-workspace">
<header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.catalog'|trans }}</p><h1>{{ 'common.products'|trans }}</h1><p>{{ 'admin.products_help'|trans }}</p></div><div class="admin-toolbar__actions">{% if is_granted('PRODUCT_EDIT') %}<a class="button primary" href="{{ path('admin_products_new') }}">{{ 'admin.new_product'|trans }}</a>{% endif %}<a class="button" href="{{ path('admin_product_categories') }}">{{ 'admin.categories'|trans }}</a></div></header>
<form class="admin-filter" method="get">
<div class="admin-filter__fields"><label for="product-search">{{ 'common.search'|trans }}<input id="product-search" name="q" value="{{ q }}" placeholder="{{ 'admin.name_or_sku'|trans }}" autocomplete="off"></label><label for="product-category">{{ 'admin.category'|trans }}<select id="product-category" name="category"><option value="">{{ 'admin.all_categories'|trans }}</option>{% for category in categories %}<option value="{{ category.id }}"{% if categoryId == category.id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></label><label for="product-sort">{{ 'admin.sort'|trans }}<select id="product-sort" name="sort"><option value="name_asc"{% if sort == 'name_asc' %} selected{% endif %}>{{ 'admin.name_az'|trans }}</option><option value="name_desc"{% if sort == 'name_desc' %} selected{% endif %}>{{ 'admin.name_za'|trans }}</option></select></label></div>
<div class="admin-filter__actions"><button class="primary" type="submit">{{ 'admin.apply_filters'|trans }}</button>{% if q or categoryId %}<a class="button" href="{{ path('admin_products_index') }}">{{ 'common.clear'|trans }}</a>{% endif %}</div></form>
{% if products is empty %}<div class="admin-empty">{% if q or categoryId %}No products match the current filters.{% else %}No active products yet.{% endif %}</div>{% else %}
<div class="admin-card-grid">{% for product in products %}<article class="admin-card" aria-labelledby="product-card-{{ product.id }}"><div class="admin-card__header"><div><h2 class="admin-card__title" id="product-card-{{ product.id }}"><a href="{{ path('admin_products_show',{id:product.id}) }}">{{ product.name }}</a></h2><div class="admin-card__meta"><span>{{ product.sku ?: 'No SKU' }}{% if product.categoryName %} · {{ product.categoryName }}{% endif %}{% if product.unit %} · {{ product.unit }}{% endif %}</span></div></div>{% if product.stockQuantity <= product.lowStockThreshold %}<span class="admin-status admin-status--warning" role="status">{{ 'admin.low_stock'|trans }}</span>{% else %}<span class="admin-status admin-status--success" role="status">{{ 'admin.stock_ok'|trans }}</span>{% endif %}</div><div class="admin-card__facts"><div class="admin-fact"><small>{{ 'admin.price'|trans }}</small><strong>{{ (product.sellingPrice / 100)|number_format(0,'.',',') }}</strong></div><div class="admin-fact"><small>{{ 'common.stock'|trans }}</small><strong>{{ product.stockQuantity }}</strong></div><div class="admin-fact"><small>{{ 'admin.low_threshold'|trans }}</small><strong>{{ product.lowStockThreshold }}</strong></div><div class="admin-fact"><small>{{ 'common.status'|trans }}</small><strong>{{ 'common.active'|trans }}</strong></div></div><div class="admin-actions"><a class="button" href="{{ path('admin_products_show',{id:product.id}) }}">{{ 'admin.view_product'|trans }}</a>{% if is_granted('PRODUCT_EDIT') %}<a class="button" href="{{ path('admin_products_edit',{id:product.id}) }}">{{ 'common.edit'|trans }}</a>{% endif %}</div></article>{% endfor %}</div>{% endif %}
{% if pagination.totalPages > 1 %}<nav class="pagination" aria-label="Product pagination"><a class="button{% if pagination.page <= 1 %} disabled{% endif %}"{% if pagination.page > 1 %} href="{{ path('admin_products_index',{q:q,category:categoryId,sort:sort,page:pagination.page-1}) }}"{% endif %}>{{ 'common.previous'|trans }}</a><div class="pagination-pages">{% for p in 1..pagination.totalPages %}{% if p == pagination.page %}<span aria-current="page" class="current">{{ p }}</span>{% elseif p <= 3 or p > pagination.totalPages - 2 or (p >= pagination.page - 1 and p <= pagination.page + 1) %}<a href="{{ path('admin_products_index',{q:q,category:categoryId,sort:sort,page:p}) }}">{{ p }}</a>{% elseif p == 4 or p == pagination.totalPages - 2 %}<span>…</span>{% endif %}{% endfor %}</div><a class="button{% if pagination.page >= pagination.totalPages %} disabled{% endif %}"{% if pagination.page < pagination.totalPages %} href="{{ path('admin_products_index',{q:q,category:categoryId,sort:sort,page:pagination.page+1}) }}"{% endif %}>{{ 'common.next'|trans }}</a></nav>{% endif %}
</div>{% endblock %}
