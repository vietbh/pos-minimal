{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ product ? 'admin.edit_product'|trans : 'admin.new_product'|trans }}{% endblock %}
{% block authenticated_body %}
<div class="admin-workspace"><header class="admin-toolbar"><div><p class="eyebrow">{{ 'admin.catalog'|trans }}</p><h1>{{ product ? 'admin.edit_product'|trans : 'admin.new_product'|trans }}</h1><p>{{ 'admin.keep_product_clear'|trans }}</p></div><div class="admin-toolbar__actions"><a class="button" href="{{ product ? path('admin_products_show',{id:product.id}) : path('admin_products_index') }}">{{ 'common.back'|trans }}</a></div></header>
{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}
<form class="admin-form" method="post" data-controller="product-form" data-action="submit->product-form#submit">
<input type="hidden" name="_token" value="{{ csrf_token('admin_product_form') }}">
<div class="admin-form__group"><h2>{{ 'admin.product_information'|trans }}</h2><label>{{ 'admin.name'|trans }}<input required maxlength="255" name="name" value="{{ data.name }}" data-product-form-target="name" data-action="input->product-form#nameChanged" autocomplete="off" autofocus></label><label>{{ 'admin.unit'|trans }}<input name="unit" value="{{ data.unit }}" autocomplete="off"></label><label>{{ 'admin.note'|trans }}<textarea name="note">{{ data.note }}</textarea></label></div>
<div class="admin-form__group"><h2>{{ 'admin.catalog'|trans }}</h2><label>{{ 'admin.sku'|trans }} <span class="admin-help">{{ 'admin.sku_optional'|trans }}</span><div class="input-with-action"><input name="sku" value="{{ data.sku }}" data-product-form-target="sku" data-action="input->product-form#skuChanged" autocomplete="off" maxlength="100" placeholder="Auto-generated SKU"><button class="button" type="button" data-action="product-form#generateSku">{{ 'admin.generate_sku'|trans }}</button></div></label><label>{{ 'admin.category'|trans }}<select name="categoryId" data-product-form-target="category" data-action="change->product-form#categoryChanged"><option value="">{{ 'admin.no_category'|trans }}</option>{% for category in categories %}<option value="{{ category.id }}"{% if data.categoryId == category.id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></label>{% if not product %}<label>{{ 'admin.create_category'|trans }} <span class="admin-help">{{ 'admin.category_help'|trans }}</span><input name="categoryName" value="{{ data.categoryName|default('') }}" data-product-form-target="categoryName" placeholder="For example: Beverages"></label>{% endif %}</div>
<div class="admin-form__group"><h2>{{ 'admin.pricing_inventory'|trans }}</h2><label>{{ 'admin.selling_price'|trans }}<input required inputmode="decimal" min="0" step="1" name="sellingPrice" value="{{ data.sellingPrice }}" data-product-form-target="sellingPrice"></label><label>{{ 'admin.cost_price'|trans }}<input inputmode="decimal" min="0" step="1" name="costPrice" value="{{ data.costPrice }}" data-product-form-target="costPrice"></label><label>{{ 'admin.low_stock_threshold'|trans }}<input type="number" min="0" step="1" name="lowStockThreshold" value="{{ data.lowStockThreshold }}"></label></div>
<div class="admin-form__actions"><button class="primary" type="submit">{{ product ? 'admin.save_changes'|trans : 'admin.create_product'|trans }}</button><a class="button" href="{{ product ? path('admin_products_show',{id:product.id}) : path('admin_products_index') }}">{{ 'common.cancel'|trans }}</a></div>
</form></div>{% endblock %}
