{% extends 'base.html.twig' %}
{% block title %}{{ product ? 'Edit product' : 'New product' }}{% endblock %}
{% block body %}<div class="app-shell"><header class="app-header"><h1>{{ product ? 'Edit product' : 'New product' }}</h1><a href="{{ product ? path('admin_products_show',{id:product.id}) : path('admin_products_index') }}">Back</a></header>
{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}
<form class="form-card" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_form') }}"><label>Name<input required name="name" value="{{ data.name }}"></label><label>SKU<input name="sku" value="{{ data.sku }}"></label><label>Unit<input name="unit" value="{{ data.unit }}"></label><label>Selling price<input required inputmode="decimal" name="sellingPrice" value="{{ data.sellingPrice }}"></label><label>Cost price<input inputmode="decimal" name="costPrice" value="{{ data.costPrice }}"></label><label>Low stock threshold<input type="number" min="0" name="lowStockThreshold" value="{{ data.lowStockThreshold }}"></label><label>Note<textarea name="note">{{ data.note }}</textarea></label><button class="primary" type="submit">{{ product ? 'Save changes' : 'Create product' }}</button></form></div>{% endblock %}
