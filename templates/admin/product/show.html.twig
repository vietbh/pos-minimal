{% extends 'base.html.twig' %}
{% block title %}{{ product.name }}{% endblock %}
{% block body %}<div class="app-shell"><header class="app-header"><div><h1>{{ product.name }}</h1><small>{{ product.sku ?: 'No SKU' }}</small></div><a href="{{ path('admin_products_index') }}">Products</a></header>
{% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}
<section class="stats"><div><small>Price</small><strong>{{ (product.sellingPrice.minorUnits / 100)|number_format(0,'.',',') }}</strong></div><div><small>Stock</small><strong>{{ product.stockQuantity }}</strong></div><div><small>Status</small><strong>{{ product.active ? 'Active' : 'Inactive' }}</strong></div></section>
<div class="action-grid">{% if is_granted('PRODUCT_EDIT') %}<a class="button primary" href="{{ path('admin_products_edit',{id:product.id}) }}">Edit</a>{% endif %}{% if is_granted('PRODUCT_ACTIVATE') %}{% if product.active %}<form method="post" action="{{ path('admin_products_deactivate',{id:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_state') }}"><button>Deactivate</button></form>{% else %}<form method="post" action="{{ path('admin_products_activate',{id:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_state') }}"><button>Activate</button></form>{% endif %}{% endif %}{% if is_granted('PRODUCT_EDIT') %}<a class="button" href="{{ path('product_image_upload_form',{productId:product.id}) }}">Images</a>{% endif %}</div>
{% if is_granted('PRODUCT_PRICE_CHANGE') %}<form class="inline-form" method="post" action="{{ path('admin_products_price',{id:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_price') }}"><label>Change price<input inputmode="decimal" name="sellingPrice" value="{{ product.sellingPrice.toDecimal }}"></label><button type="submit">Update price</button></form>{% endif %}
{% if is_granted('STOCK_ADJUST') %}<form class="inline-form" method="post" action="{{ path('admin_products_stock',{id:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_adjust') }}"><input type="hidden" name="idempotencyKey" value="{{ random() }}-{{ product.id }}"><label>Stock delta<input type="number" name="quantityChange" required></label><label>Reason<input name="reason" placeholder="Optional"></label><button type="submit">Adjust stock</button></form>{% endif %}
<h2>Stock history</h2>{% if movements is empty %}<div class="empty-state">No stock movements yet.</div>{% else %}<div class="table-scroll"><table><thead><tr><th>Date</th><th>Type</th><th>Before</th><th>Change</th><th>After</th><th>Reason</th></tr></thead><tbody>{% for m in movements %}<tr><td>{{ m.createdAt|date('Y-m-d H:i') }}</td><td>{{ m.type.value }}</td><td>{{ m.quantityBefore }}</td><td>{{ m.quantityChange }}</td><td>{{ m.quantityAfter }}</td><td>{{ m.reason ?: '—' }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</div>{% endblock %}
