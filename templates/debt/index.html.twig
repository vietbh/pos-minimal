{% extends 'base.html.twig' %}
{% block title %}Debts{% endblock %}
{% block body %}
<main class="page-shell"><header class="page-header"><div><h1>Debts</h1><p class="muted">Outstanding customer balances</p></div></header>
<form class="search-form" method="get"><input name="q" value="{{ search }}" placeholder="Customer or order" aria-label="Search debts"><select name="status" aria-label="Filter by status"><option value="">All statuses</option>{% for s in ['OPEN','PARTIALLY_PAID','PAID','REVERSED'] %}<option value="{{ s }}"{% if status==s %} selected{% endif %}>{{ s|title }}</option>{% endfor %}</select><button type="submit">Search</button></form>
<section class="card-list">{% for debt in debts.items %}<a class="card" href="{{ path('debts_show',{id:debt.id}) }}"><div class="card-main"><strong>{{ debt.customerName }}</strong><span class="muted">Order #{{ debt.orderNumber }}</span></div><div class="card-main"><span>{{ debt.status|title }}</span><strong>{{ debt.remainingAmount }} đ</strong></div></a>{% else %}<div class="empty-state">No debts found.</div>{% endfor %}</section>
{% if debts.totalPages > 1 %}<nav class="pagination" aria-label="Debt pages">{% for p in 1..debts.totalPages %}<a href="{{ path('debts_index',{q:search,status:status,page:p}) }}"{% if p==debts.page %} aria-current="page"{% endif %}>{{ p }}</a>{% endfor %}</nav>{% endif %}</main>
{% endblock %}
