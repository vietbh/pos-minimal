{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'debt.title'|trans }}{% endblock %}
{% block authenticated_body %}
<main class="business-page">
    <header class="business-page-header"><div><h1>{{ 'debt.title'|trans }}</h1><p>{{ 'debt.help'|trans }}</p></div></header>
    <form class="business-search" method="get" role="search" aria-label="{{ 'debt.search'|trans }}">
        <label for="debt-search">{{ 'debt.search'|trans }}<input id="debt-search" name="q" value="{{ search }}" placeholder="{{ 'debt.search_placeholder'|trans }}" autocomplete="off"></label>
        <label for="debt-status">{{ 'common.status'|trans }}<select id="debt-status" name="status"><option value="">{{ 'debt.all_statuses'|trans }}</option>{% for s in ['OPEN','PARTIALLY_PAID','PAID','REVERSED'] %}<option value="{{ s }}"{% if status==s %} selected{% endif %}>{{ s|title }}</option>{% endfor %}</select></label>
        <button type="submit">{{ 'common.search'|trans }}</button>
    </form>
    {% if debts.items is empty %}
        <div class="business-empty"><strong>{{ 'debt.no_found'|trans }}</strong><span>{{ 'debt.search_placeholder'|trans }}</span></div>
    {% else %}
        <section class="card-list" aria-label="{{ 'debt.title'|trans }}">
            {% for debt in debts.items %}
                <a class="business-row-link" href="{{ path('debts_show',{id:debt.id}) }}">
                    <span class="business-row-link-main"><strong>{{ debt.customerName }}</strong><span>{{ 'debt.order'|trans }} #{{ debt.orderNumber }}</span></span>
                    <span class="business-row-amount"><strong>{{ debt.remainingAmount|money_vnd }}</strong><span class="business-status" data-status="{{ debt.status }}">{{ debt.status|title }}</span></span>
                </a>
            {% endfor %}
        </section>
        {% if debts.totalPages > 1 %}<nav class="pagination" aria-label="{{ 'debt.pages_aria'|trans }}">{% for p in 1..debts.totalPages %}<a href="{{ path('debts_index',{q:search,status:status,page:p}) }}"{% if p==debts.page %} aria-current="page"{% endif %}>{{ p }}</a>{% endfor %}</nav>{% endif %}
    {% endif %}
</main>
{% endblock %}
