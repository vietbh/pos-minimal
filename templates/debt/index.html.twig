{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'debt.title'|trans }}{% endblock %}
{% block authenticated_body %}<main class="page-shell debt-page"><header class="page-header"><div><p class="page-eyebrow">{{ 'debt.eyebrow'|trans }}</p><h1>{{ 'debt.title'|trans }}</h1><p class="muted">{{ 'debt.subtitle'|trans }}</p></div></header><form class="search-form" method="get" role="search" aria-label="{{ 'debt.search_label'|trans }}"><label>{{ 'debt.search'|trans }}<input name="q" value="{{ search }}" placeholder="{{ 'debt.search_placeholder'|trans }}"></label><label>{{ 'debt.status'|trans }}<select name="status"><option value="">{{ 'debt.all_statuses'|trans }}</option>{% for s in ['OPEN','PARTIALLY_PAID','PAID','REVERSED'] %}<option value="{{ s }}"{% if status==s %} selected{% endif %}>{{ s|title }}</option>{% endfor %}</select></label><button class="primary" type="submit">{{ 'debt.search_action'|trans }}</button></form><section class="card-list" aria-label="{{ 'debt.list_label'|trans }}">{% for debt in debts.items %}<a class="card debt-row" href="{{ path('debts_show',{id:debt.id}) }}"><div><strong>{{ debt.customerName }}</strong><span class="muted">{{ 'debt.order'|trans({'%number%':debt.orderNumber}) }}</span></div><div class="debt-row-right"><span class="status-pill">{{ debt.status|title }}</span><strong>{{ debt.remainingAmount|money_vnd }}</strong></div></a>{% else %}<div class="empty-state">{{ 'debt.empty'|trans }}</div>{% endfor %}</section>{% if debts.totalPages > 1 %}<nav class="pagination" aria-label="{{ 'debt.pagination'|trans }}">{% for p in 1..debts.totalPages %}<a class="button" href="{{ path('debts_index',{q:search,status:status,page:p}) }}"{% if p==debts.page %} aria-current="page"{% endif %}>{{ p }}</a>{% endfor %}</nav>{% endif %}</main>{% endblock %}
