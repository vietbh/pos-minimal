{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'debt.detail_title'|trans({'%id%':debt.id}) }}{% endblock %}
{% block authenticated_body %}<main class="page-shell debt-page" data-controller="debt-payment" data-debt-payment-url-value="{{ path('debt_payment',{id:debt.id}) }}" data-debt-payment-csrf-value="{{ csrfToken }}" data-debt-payment-required-label-value="{{ 'debt.payment_required'|trans }}" data-debt-payment-generic-error-label-value="{{ 'debt.payment_error'|trans }}" data-debt-payment-recorded-label-value="{{ 'debt.payment_recorded'|trans }}"><a class="button" href="{{ path('debts_index') }}">← {{ 'debt.back'|trans }}</a><header class="page-header debt-header"><div><p class="page-eyebrow">{{ 'debt.eyebrow'|trans }}</p><h1>{{ debt.customerName }}</h1><p class="muted">{{ 'debt.order'|trans({'%number%':debt.orderNumber}) }} <a href="{{ path('orders_show',{id:debt.orderId}) }}">#{{ debt.orderNumber }}</a></p></div><span class="status-pill">{{ debt.status|title }}</span></header><section class="summary-grid debt-summary"><div><span class="muted">{{ 'debt.original'|trans }}</span><strong>{{ debt.originalAmount|money_vnd }}</strong></div><div><span class="muted">{{ 'debt.paid'|trans }}</span><strong>{{ debt.paidAmount|money_vnd }}</strong></div><div><span class="muted">{{ 'debt.remaining'|trans }}</span><strong data-debt-payment-target="remaining">{{ debt.remainingAmount|money_vnd }}</strong></div></section>{% if debt.canPay %}<section class="card"><h2>{{ 'debt.pay_title'|trans }}</h2><p class="muted">{{ 'debt.pay_help'|trans }}</p><form data-debt-payment-target="form"><label>{{ 'debt.amount'|trans }}<input name="amount" inputmode="decimal" autocomplete="off" required aria-describedby="debt-payment-error"></label><button class="primary" type="submit" data-debt-payment-target="submit">{{ 'debt.pay'|trans }}</button><p id="debt-payment-error" role="alert" hidden data-debt-payment-target="error"></p><p role="status" hidden data-debt-payment-target="success"></p></form></section>{% endif %}<section class="card"><h2>{{ 'debt.history'|trans }}</h2>{% for payment in debt.payments %}<div class="list-row"><span>{{ payment.createdAt|date('d/m/Y H:i') }} · {{ payment.username }}</span><strong>{{ payment.amount|money_vnd }}</strong></div>{% else %}<p class="muted">{{ 'debt.no_payments'|trans }}</p>{% endfor %}</section></main>{% endblock %}
