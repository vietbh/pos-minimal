{% extends 'base.html.twig' %}
{% block title %}Debt #{{ debt.id }}{% endblock %}
{% block body %}
<main class="page-shell" data-controller="debt-payment" data-debt-payment-url-value="{{ path('debt_payment',{id:debt.id}) }}" data-debt-payment-csrf-value="{{ csrfToken }}">
<a href="{{ path('debts_index') }}">← Debts</a><header class="page-header"><div><h1>{{ debt.customerName }}</h1><p class="muted">Order <a href="{{ path('orders_show',{id:debt.orderId}) }}">#{{ debt.orderNumber }}</a></p></div><span class="status-pill">{{ debt.status|title }}</span></header>
<section class="summary-grid"><div><span class="muted">Original</span><strong>{{ debt.originalAmount }} đ</strong></div><div><span class="muted">Paid</span><strong>{{ debt.paidAmount }} đ</strong></div><div><span class="muted">Remaining</span><strong data-debt-payment-target="remaining">{{ debt.remainingAmount }} đ</strong></div></section>
{% if debt.canPay %}<section class="card"><h2>Pay debt</h2><form data-debt-payment-target="form"><label>Amount<input name="amount" inputmode="decimal" autocomplete="off" required aria-describedby="debt-payment-error"></label><button type="submit" data-debt-payment-target="submit">Pay</button><p id="debt-payment-error" role="alert" hidden data-debt-payment-target="error"></p><p role="status" hidden data-debt-payment-target="success"></p></form></section>{% endif %}
<section class="card"><h2>Payment history</h2>{% for payment in debt.payments %}<div class="list-row"><span>{{ payment.createdAt|date('d/m/Y H:i') }} · {{ payment.username }}</span><strong>{{ payment.amount }} đ</strong></div>{% else %}<p class="muted">No payments recorded.</p>{% endfor %}</section>
</main>
{% endblock %}
