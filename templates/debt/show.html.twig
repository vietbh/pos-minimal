{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'debt.title'|trans }} #{{ debt.id }}{% endblock %}
{% block authenticated_body %}
<main class="business-page" data-controller="debt-payment" data-debt-payment-url-value="{{ path('debt_payment',{id:debt.id}) }}" data-debt-payment-csrf-value="{{ csrfToken }}" data-debt-payment-required-message-value="{{ 'debt.payment_required'|trans }}" data-debt-payment-failed-message-value="{{ 'debt.payment_failed'|trans }}" data-debt-payment-recorded-template-value="{{ 'debt.payment_recorded'|trans }}">
<a class="business-back" href="{{ path('debts_index') }}">{{ 'debt.back'|trans }}</a><header class="page-header"><div><h1>{{ debt.customerName }}</h1><p class="muted">{{ 'debt.order'|trans }} <a href="{{ path('orders_show',{id:debt.orderId}) }}">#{{ debt.orderNumber }}</a></p></div><span class="business-status" data-status="{{ debt.status }}">{{ debt.status|title }}</span></header>
<section class="business-summary-grid" aria-label="{{ 'debt.title'|trans }}"><div><span class="muted">{{ 'stat.original'|trans }}</span><strong>{{ debt.originalAmount }} đ</strong></div><div><span class="muted">{{ 'order.paid'|trans }}</span><strong>{{ debt.paidAmount }} đ</strong></div><div><span class="muted">{{ 'order.debt_remaining'|trans }}</span><strong data-debt-payment-target="remaining">{{ debt.remainingAmount }} đ</strong></div></section>
{% if debt.canPay %}<section class="business-card"><h2>{{ 'debt.pay'|trans }}</h2><form data-debt-payment-target="form"><label>{{ 'common.amount'|trans }}<input name="amount" inputmode="decimal" autocomplete="off" required aria-describedby="debt-payment-error"></label><button type="submit" data-debt-payment-target="submit">{{ 'debt.pay_action'|trans }}</button><p id="debt-payment-error" role="alert" hidden data-debt-payment-target="error"></p><p role="status" hidden data-debt-payment-target="success"></p></form></section>{% endif %}
<section class="business-card"><h2>{{ 'debt.history'|trans }}</h2>{% for payment in debt.payments %}<div class="list-row"><span>{{ payment.createdAt|date('d/m/Y H:i') }} · {{ payment.username }}</span><strong>{{ payment.amount }} đ</strong></div>{% else %}<p class="muted">{{ 'order.no_payments'|trans }}</p>{% endfor %}</section>
</main>
{% endblock %}
