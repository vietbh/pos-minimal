{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.page_title'|trans }}{% endblock %}

{% block body %}
<div class="login-page" data-login-page>
    <div class="login-shell">
        <main class="login-main" aria-labelledby="login-title">
            <header class="login-header">
                <div class="login-brand" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="5" y="3" width="14" height="18" rx="1.5"/>
                        <path stroke-linecap="round" d="M8 7h8M8 11h8M8 15h4"/>
                    </svg>
                </div>
                <p class="login-kicker">{{ 'auth.login.brand'|trans }}</p>
                <h1 id="login-title" class="login-title">{{ 'auth.login.title'|trans }}</h1>
                <p class="login-subtitle">{{ 'auth.login.subtitle'|trans }}</p>
            </header>

            <section class="login-card" aria-labelledby="login-form-title">
                <h2 id="login-form-title" class="visually-hidden">{{ 'auth.login.form_title'|trans }}</h2>

                {% if error %}
                    <div class="login-error" role="alert" aria-live="assertive" tabindex="-1" id="login-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"/>
                            <path stroke-linecap="round" d="M12 8v4M12 16h.01"/>
                        </svg>
                        <div>
                            <p class="login-error-title">{{ 'auth.login.error_title'|trans }}</p>
                            <p class="login-error-text">{{ 'auth.login.invalid_credentials'|trans }}</p>
                        </div>
                    </div>
                {% endif %}

                <form
                    method="post"
                    action="{{ path('login') }}"
                    data-controller="login"
                    data-action="submit->login#submit"
                    data-login-submitting-label-value="{{ 'auth.login.submitting'|trans }}"
                    data-login-submit-label-value="{{ 'auth.login.submit'|trans }}"
                    class="login-form"
                    novalidate
                >
                    <div class="login-field">
                        <label for="username" class="login-label">{{ 'auth.login.username'|trans }}</label>
                        <input
                            id="username"
                            type="text"
                            name="_username"
                            value="{{ last_username }}"
                            autocomplete="username"
                            autocapitalize="none"
                            spellcheck="false"
                            required
                            autofocus
                            class="login-input"
                            placeholder="{{ 'auth.login.username_placeholder'|trans }}"
                            aria-describedby="username-help"
                        >
                        <p id="username-help" class="login-field-help">{{ 'auth.login.username_help'|trans }}</p>
                    </div>

                    <div class="login-field">
                        <label for="password" class="login-label">{{ 'auth.login.password'|trans }}</label>
                        <div class="login-password-wrap">
                            <input
                                id="password"
                                type="password"
                                name="_password"
                                autocomplete="current-password"
                                required
                                class="login-input login-input-password"
                                placeholder="{{ 'auth.login.password_placeholder'|trans }}"
                                data-login-target="password"
                                aria-describedby="password-help"
                            >
                            <button
                                type="button"
                                class="login-password-toggle"
                                data-action="click->login#togglePassword"
                                data-login-target="toggle"
                                data-show-label="{{ 'auth.login.show_password'|trans }}"
                                data-hide-label="{{ 'auth.login.hide_password'|trans }}"
                                aria-label="{{ 'auth.login.show_password'|trans }}"
                                aria-pressed="false"
                            >
                                <svg data-login-target="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/>
                                    <circle cx="12" cy="12" r="2.5"/>
                                </svg>
                            </button>
                        </div>
                        <p id="password-help" class="login-field-help">{{ 'auth.login.password_help'|trans }}</p>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="login-remember-group">
                        <label class="login-remember">
                            <input
                                type="checkbox"
                                name="_remember_me"
                                value="1"
                                class="login-remember-checkbox"
                            >
                            <span>{{ 'auth.login.remember_me'|trans }}</span>
                        </label>
                        <p class="login-remember-help">{{ 'auth.login.remember_me_help'|trans }}</p>
                    </div>

                    <button
                        type="submit"
                        data-login-target="submit"
                        class="login-submit"
                    >
                        <svg data-login-target="spinner" class="login-spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".25"/>
                            <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                        <span data-login-target="submitLabel">{{ 'auth.login.submit'|trans }}</span>
                    </button>
                </form>
            </section>

            <p class="login-footer">{{ 'auth.login.footer'|trans }}</p>
        </main>
    </div>
</div>
{% endblock %}
