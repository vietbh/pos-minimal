{% extends 'base.html.twig' %}{% block title %}{{ customer.name }}{% endblock %}{% block body %}<div class="app-shell"><header class="app-header"><h1>{{ customer.name }}</h1><a href="{{ path('customers_index') }}">Customers</a></header>{% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}<div class="form-card"><p><strong>Phone:</strong> {{ customer.phone ?: '—' }}</p><p><strong>Note:</strong> {{ customer.note ?: '—' }}</p><p><small>Created {{ customer.createdAt|date('Y-m-d H:i') }}</small></p>{% if is_granted('CUSTOMER_EDIT') %}<a class="button primary" href="{{ path('customers_edit',{id:customer.id}) }}">Edit customer</a>{% endif %}</div></div>{% endblock %}
