{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ customer.name }}{% endblock %}

{% block stylesheets %}
<style>
    .customer-page { max-width: 900px; margin: 0 auto; padding: 16px 14px 40px; }
    .customer-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:16px; }
    .customer-header h1 { margin:0; font-size:24px; line-height:1.2; }
    .customer-header p { margin:6px 0 0; color:#475569; }
    .customer-actions { display:flex; gap:8px; flex-wrap:wrap; }
    .customer-actions a { min-height:48px; padding:0 14px; border:1px solid #cbd5e1; border-radius:10px; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; background:#fff; box-sizing:border-box; }
    .customer-actions .primary { background:#1d4ed8; border-color:#1d4ed8; color:#fff; }
    .customer-card { background:#fff; border:1px solid #cbd5e1; border-radius:16px; padding:16px; margin-bottom:14px; }
    .customer-card h2 { margin:0 0 12px; font-size:20px; }
    .customer-contact { display:grid; gap:8px; }
    .customer-contact-row { display:grid; grid-template-columns:110px 1fr; gap:10px; }
    .customer-label { color:#475569; font-weight:700; }
    .customer-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
    .customer-stat { padding:14px; border:1px solid #cbd5e1; border-radius:14px; background:#fff; }
    .customer-stat small,.customer-stat strong { display:block; }
    .customer-stat small { color:#475569; font-weight:700; }
    .customer-stat strong { margin-top:5px; font-size:20px; font-variant-numeric:tabular-nums; }
    .customer-stat.alert strong { color:#b45309; }
    .customer-list { display:grid; gap:9px; }
    .customer-row { display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:48px; padding:12px; border:1px solid #e2e8f0; border-radius:12px; text-decoration:none; color:inherit; box-sizing:border-box; }
    .customer-row-main { min-width:0; }
    .customer-row-main strong,.customer-row-main span { display:block; }
    .customer-row-main span { margin-top:3px; color:#475569; font-size:15px; }
    .customer-row-amount { text-align:right; white-space:nowrap; }
    .customer-row-amount strong { display:block; font-variant-numeric:tabular-nums; }
    .customer-row-amount span { color:#475569; font-size:14px; }
    .customer-empty { padding:22px 16px; color:#475569; text-align:center; border:1px dashed #cbd5e1; border-radius:14px; }
    .customer-muted { color:#475569; }
    .customer-footer { color:#64748b; font-size:14px; margin-top:12px; }
    .customer-header a:focus-visible,.customer-actions a:focus-visible,.customer-row:focus-visible { outline:3px solid #93c5fd; outline-offset:2px; }
    @media(max-width:640px) {
        .customer-header { flex-direction:column; }
        .customer-actions { width:100%; }
        .customer-actions a { flex:1 1 0; }
        .customer-stats { grid-template-columns:1fr; }
        .customer-contact-row { grid-template-columns:1fr; gap:3px; }
        .customer-row { align-items:flex-start; }
        .customer-row-amount { text-align:right; }
    }
    @media(prefers-reduced-motion:reduce) { .customer-row { scroll-behavior:auto; } }
</style>
{% endblock %}

{% block authenticated_body %}
<main class="customer-page">
    <header class="customer-header">
        <div>
            <h1>{{ customer.name }}</h1>
            <p>{{ 'customer.info_help'|trans }}</p>
        </div>
        <div class="customer-actions">
            <a href="{{ path('customers_index') }}">{{ 'common.customers'|trans }}</a>
            {% if is_granted('CUSTOMER_EDIT') %}
                <a class="primary" href="{{ path('customers_edit', {id: customer.id}) }}">{{ 'customer.edit'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <section class="customer-card" aria-labelledby="customer-info-title">
        <h2 id="customer-info-title">{{ 'customer.info'|trans }}</h2>
        <div class="customer-contact">
            <div class="customer-contact-row"><span class="customer-label">{{ 'customer.phone'|trans }}</span><span>{{ customer.phone ?: ('customer.no_data'|trans) }}</span></div>
            <div class="customer-contact-row"><span class="customer-label">{{ 'admin.note'|trans }}</span><span>{{ customer.note ?: ('customer.no_data'|trans) }}</span></div><div class="customer-contact-row"><span class="customer-label">Giảm giá mặc định</span><span>{{ customer.defaultDiscountPercent }}%</span></div>
        </div>
        <div class="customer-footer">{{ 'customer.updated_at'|trans }} {{ customer.updatedAt|date('d/m/Y H:i') }}</div>
    </section>

    <section aria-labelledby="debt-summary-title">
        <h2 id="debt-summary-title">{{ 'debt.title'|trans }}</h2>
        <div class="customer-stats">
            <div class="customer-stat"><small>{{ 'customer.debt_total'|trans }}</small><strong>{{ customer.debtOriginalAmount|money_vnd }}</strong></div>
            <div class="customer-stat"><small>{{ 'order.paid'|trans }}</small><strong>{{ customer.debtPaidAmount|money_vnd }}</strong></div>
            <div class="customer-stat alert"><small>{{ 'customer.debt_remaining'|trans }}</small><strong>{{ customer.debtRemainingAmount|money_vnd }}</strong></div>
        </div>
    </section>

    <section class="customer-card" aria-labelledby="debt-history-title">
        <h2 id="debt-history-title">{{ 'customer.debt_history'|trans }}</h2>
        {% if is_granted('DEBT_VIEW') and customer.debts is not empty %}
            <div class="customer-list">
                {% for debt in customer.debts %}
                    <a class="customer-row" href="{{ path('debts_show', {id: debt.id}) }}">
                        <div class="customer-row-main">
                            <strong>Đơn #{{ debt.orderNumber }}</strong>
                            <span>{{ debt.createdAt|date('d/m/Y H:i') }} · {{ debt.status|title }}</span>
                        </div>
                        <div class="customer-row-amount">
                            <strong>{{ debt.remainingAmount|money_vnd }}</strong>
                            <span>{{ 'stat.outstanding'|trans }}</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
            {% if customer.debtCount > customer.debts|length %}
                <p class="customer-footer"><a href="{{ path('debts_index', {q: customer.name}) }}">{{ 'customer.all_debts'|trans({count: customer.debtCount}) }}</a></p>
            {% endif %}
        {% elseif is_granted('DEBT_VIEW') %}
            <div class="customer-empty">{{ 'customer.no_debt'|trans }}</div>
        {% else %}
            <div class="customer-empty">{{ 'customer.no_debt_permission'|trans }}</div>
        {% endif %}
    </section>

    <section class="customer-card" aria-labelledby="order-history-title">
        <h2 id="order-history-title">{{ 'customer.recent_orders'|trans }}</h2>
        {% if is_granted('ORDER_VIEW') and customer.orders is not empty %}
            <div class="customer-list">
                {% for order in customer.orders %}
                    <a class="customer-row" href="{{ path('orders_show', {id: order.id, q: customer.name}) }}">
                        <div class="customer-row-main">
                            <strong>#{{ order.orderNumber }}</strong>
                            <span>{{ order.createdAt|date('d/m/Y H:i') }} · {{ order.status.value|title }}</span>
                        </div>
                        <div class="customer-row-amount"><strong>{{ order.total|money_vnd }}</strong><span>{{ 'customer.total_orders'|trans }}</span></div>
                    </a>
                {% endfor %}
            </div>
            {% if customer.orderCount > customer.orders|length %}
                <p class="customer-footer"><a href="{{ path('orders_index', {q: customer.name}) }}">{{ 'customer.all_orders'|trans({count: customer.orderCount}) }}</a></p>
            {% endif %}
        {% elseif is_granted('ORDER_VIEW') %}
            <div class="customer-empty">{{ 'customer.no_orders'|trans }}</div>
        {% else %}
            <div class="customer-empty">{{ 'customer.no_orders_permission'|trans }}</div>
        {% endif %}
    </section>
</main>
{% endblock %}
