{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ customer.name }}{% endblock %}
{% block stylesheets %}<style>.customer-page{max-width:900px;margin:0 auto;padding:16px 14px 40px}.customer-actions{display:flex;gap:8px;flex-wrap:wrap}.customer-actions a{min-height:48px}.customer-card{margin-bottom:14px}.customer-contact{display:grid;gap:8px}.customer-contact-row{display:grid;grid-template-columns:120px 1fr;gap:10px;padding:8px 0}.customer-label{font-weight:700;color:#475569}.customer-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}.customer-stat{padding:14px;border:1px solid #cbd5e1;border-radius:14px;background:#fff}.customer-stat small,.customer-stat strong{display:block}.customer-stat small{color:#475569;font-weight:700}.customer-stat strong{margin-top:5px;font-size:20px;font-variant-numeric:tabular-nums}.customer-stat.alert strong{color:#b45309}.customer-list{display:grid;gap:9px}.customer-row{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:12px;border:1px solid #e2e8f0;border-radius:12px;text-decoration:none;color:inherit}.customer-row-main{min-width:0}.customer-row-main strong,.customer-row-main span{display:block}.customer-row-main span{margin-top:3px;color:#475569;font-size:15px}.customer-row-amount{text-align:right;white-space:nowrap}.customer-row-amount strong{display:block;font-variant-numeric:tabular-nums}.customer-row-amount span{color:#475569;font-size:14px}.customer-empty{padding:22px 16px;color:#475569;text-align:center;border:1px dashed #cbd5e1;border-radius:14px}.customer-footer{color:#64748b;font-size:14px;margin-top:12px}@media(max-width:640px){.customer-header{flex-direction:column}.customer-actions{width:100%}.customer-actions a{flex:1 1 0}.customer-stats{grid-template-columns:1fr}.customer-contact-row{grid-template-columns:1fr;gap:3px}.customer-row{align-items:flex-start}}</style>{% endblock %}
{% block authenticated_body %}<main class="customer-page"><header class="page-header customer-header"><div><p class="page-eyebrow">{{ 'customers.eyebrow'|trans }}</p><h1>{{ customer.name }}</h1><p class="muted">{{ 'customers.detail_subtitle'|trans }}</p></div><div class="customer-actions"><a class="button" href="{{ path('customers_index') }}">{{ 'customers.list'|trans }}</a>{% if is_granted('CUSTOMER_EDIT') %}<a class="button primary" href="{{ path('customers_edit',{id:customer.id}) }}">{{ 'customers.edit'|trans }}</a>{% endif %}</div></header><section class="card customer-card" aria-labelledby="customer-info-title"><h2 id="customer-info-title">{{ 'customers.info'|trans }}</h2><div class="customer-contact"><div class="customer-contact-row"><span class="customer-label">{{ 'customers.phone'|trans }}</span><span>{{ customer.phone ?: 'customers.not_available'|trans }}</span></div><div class="customer-contact-row"><span class="customer-label">{{ 'customers.note'|trans }}</span><span>{{ customer.note ?: 'customers.not_available'|trans }}</span></div></div><div class="customer-footer">{{ 'customers.updated'|trans({'%date%':customer.updatedAt|date('d/m/Y H:i')}) }}</div></section><section aria-labelledby="debt-summary-title"><h2 id="debt-summary-title">{{ 'customers.debt'|trans }}</h2><div class="customer-stats"><div class="customer-stat"><small>{{ 'customers.debt_original'|trans }}</small><strong>{{ customer.debtOriginalAmount|money_vnd }}</strong></div><div class="customer-stat"><small>{{ 'customers.debt_paid'|trans }}</small><strong>{{ customer.debtPaidAmount|money_vnd }}</strong></div><div class="customer-stat alert"><small>{{ 'customers.debt_remaining'|trans }}</small><strong>{{ customer.debtRemainingAmount|money_vnd }}</strong></div></div></section><section class="card customer-card" aria-labelledby="debt-history-title"><h2 id="debt-history-title">{{ 'customers.debt_history'|trans }}</h2>{% if is_granted('DEBT_VIEW') and customer.debts is not empty %}<div class="customer-list">{% for debt in customer.debts %}<a class="customer-row" href="{{ path('debts_show',{id:debt.id}) }}"><div class="customer-row-main"><strong>{{ 'customers.order'|trans({'%number%':debt.orderNumber}) }}</strong><span>{{ debt.createdAt|date('d/m/Y H:i') }} · {{ debt.status|title }}</span></div><div class="customer-row-amount"><strong>{{ debt.remainingAmount|money_vnd }}</strong><span>{{ 'customers.remaining'|trans }}</span></div></a>{% endfor %}</div>{% if customer.debtCount > customer.debts|length %}<p class="customer-footer"><a href="{{ path('debts_index',{q:customer.name}) }}">{{ 'customers.view_all_debts'|trans({'%count%':customer.debtCount}) }}</a></p>{% endif %}{% elseif is_granted('DEBT_VIEW') %}<div class="customer-empty">{{ 'customers.no_debt'|trans }}</div>{% else %}<div class="customer-empty">{{ 'customers.no_debt_permission'|trans }}</div>{% endif %}</section><section class="card customer-card" aria-labelledby="order-history-title"><h2 id="order-history-title">{{ 'customers.orders'|trans }}</h2>{% if is_granted('ORDER_VIEW') and customer.orders is not empty %}<div class="customer-list">{% for order in customer.orders %}<a class="customer-row" href="{{ path('orders_show',{id:order.id,q:customer.name}) }}"><div class="customer-row-main"><strong>#{{ order.orderNumber }}</strong><span>{{ order.createdAt|date('d/m/Y H:i') }} · {{ order.status.value|title }}</span></div><div class="customer-row-amount"><strong>{{ order.total|money_vnd }}</strong><span>{{ 'customers.order_total'|trans }}</span></div></a>{% endfor %}</div>{% if customer.orderCount > customer.orders|length %}<p class="customer-footer"><a href="{{ path('orders_index',{q:customer.name}) }}">{{ 'customers.view_all_orders'|trans({'%count%':customer.orderCount}) }}</a></p>{% endif %}{% elseif is_granted('ORDER_VIEW') %}<div class="customer-empty">{{ 'customers.no_orders'|trans }}</div>{% else %}<div class="customer-empty">{{ 'customers.no_order_permission'|trans }}</div>{% endif %}</section></main>{% endblock %}
