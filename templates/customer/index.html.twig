{% extends 'layout/authenticated.html.twig' %}

{% block title %}{{ 'customer.title'|trans }}{% endblock %}

{% block authenticated_body %}
<main class="business-page">
    <header class="business-page-header">
        <div><h1>{{ 'customer.title'|trans }}</h1><p>{{ 'customer.search_help'|trans }}</p></div>
        <div class="business-actions">
            {% if is_granted('CUSTOMER_CREATE') %}<a class="primary" href="{{ path('customers_new') }}">{{ 'customer.form_new'|trans }}</a>{% endif %}
            <a href="{{ path('pos') }}">{{ 'customer.pos'|trans }}</a>
        </div>
    </header>

    {% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}

    <form class="business-search" method="get" role="search" aria-label="{{ 'customer.search'|trans }}">
        <label for="customer-search">{{ 'customer.search'|trans }}<input id="customer-search" name="q" value="{{ q }}" placeholder="{{ 'customer.name_or_phone'|trans }}" autocomplete="off"></label>
        <button type="submit">{{ 'common.search'|trans }}</button>
    </form>

    {% if q == '' %}
        <div class="business-empty"><strong>{{ 'customer.search_help'|trans }}</strong><span>{{ 'customer.name_or_phone'|trans }}</span></div>
    {% elseif customers is empty %}
        <div class="business-empty"><strong>{{ 'customer.no_found'|trans }}</strong><span>{{ 'customer.search_help'|trans }}</span></div>
    {% else %}
        <section class="card-list" aria-label="{{ 'customer.title'|trans }}">
            {% for customer in customers %}
                <a class="business-row-link" href="{{ path('customers_show',{id:customer.id}) }}">
                    <span class="business-row-link-main"><strong>{{ customer.name }}</strong><span>{{ customer.phone ?: ('customer.no_phone'|trans) }}</span></span>
                    <span aria-hidden="true">→</span>
                </a>
            {% endfor %}
        </section>
    {% endif %}
</main>
{% endblock %}
