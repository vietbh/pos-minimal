{% extends 'layout/authenticated.html.twig' %}{% block title %}Customers{% endblock %}{% block authenticated_body %}<div class="app-shell"><header class="app-header"><h1>{{ 'common.customers'|trans }}</h1><nav><a href="{{ path('pos') }}">{{ 'customer.pos'|trans }}</a> <a href="{{ path('admin_products_index') }}">{{ 'common.products'|trans }}</a> {% if is_granted('CUSTOMER_CREATE') %}<a class="button" href="{{ path('customers_new') }}">{{ 'customer.form_new'|trans }}</a>{% endif %}</nav></header>{% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}<form class="search-bar" method="get"><label for="customer-search">{{ 'customer.search'|trans }}</label><input id="customer-search" name="q" value="{{ q }}" placeholder="{{ 'customer.name_or_phone'|trans }}"><button>{{ 'common.search'|trans }}</button></form>{% if customers is empty %}<div class="empty-state">{{ q == '' ? 'customer.no_customers'|trans : 'customer.no_found'|trans }}</div>{% else %}<div class="card-list">{% for customer in customers %}<a class="card" href="{{ path('customers_show',{id:customer.id}) }}"><div><strong>{{ customer.name }}</strong><small>{{ customer.phone ?: ('customer.no_phone'|trans) }}</small></div></a>{% endfor %}</div>{% endif %}</div>{% endblock %}
