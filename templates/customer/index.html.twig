{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ 'customers.title'|trans }}{% endblock %}
{% block authenticated_body %}<main class="page-shell customer-page"><header class="page-header"><div><p class="page-eyebrow">{{ 'customers.eyebrow'|trans }}</p><h1>{{ 'customers.title'|trans }}</h1><p class="muted">{{ 'customers.subtitle'|trans }}</p></div>{% if is_granted('CUSTOMER_CREATE') %}<a class="button primary" href="{{ path('customers_new') }}">{{ 'customers.new'|trans }}</a>{% endif %}</header>{% for message in app.flashes('success') %}<div class="flash success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}<form class="search-form" method="get" role="search" aria-label="{{ 'customers.search_label'|trans }}"><label>{{ 'customers.search'|trans }}<input id="customer-search" name="q" value="{{ q }}" placeholder="{{ 'customers.search_placeholder'|trans }}" autocomplete="off"></label><button class="primary" type="submit">{{ 'customers.search_action'|trans }}</button></form>{% if q == '' %}<div class="empty-state">{{ 'customers.search_hint'|trans }}</div>{% elseif customers is empty %}<div class="empty-state"><strong>{{ 'customers.empty_title'|trans }}</strong><span>{{ 'customers.empty_message'|trans }}</span></div>{% else %}<section class="card-list" aria-label="{{ 'customers.list_label'|trans }}">{% for customer in customers %}<a class="card customer-list-card" href="{{ path('customers_show',{id:customer.id}) }}"><div><strong>{{ customer.name }}</strong><span class="muted">{{ customer.phone ?: 'customers.no_phone'|trans }}</span></div><span aria-hidden="true">›</span></a>{% endfor %}</section>{% endif %}</main>{% endblock %}
