{% extends 'base.html.twig' %}{% block title %}Customers{% endblock %}{% block body %}<div class="app-shell"><header class="app-header"><h1>Customers</h1><nav><a href="{{ path('pos') }}">POS</a> <a href="{{ path('admin_products_index') }}">Products</a> {% if is_granted('CUSTOMER_CREATE') %}<a class="button" href="{{ path('customers_new') }}">New customer</a>{% endif %}</nav></header>{% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}<form class="search-bar" method="get"><label for="customer-search">Search customer</label><input id="customer-search" name="q" value="{{ q }}" placeholder="Name or phone"><button>Search</button></form>{% if q == '' %}<div class="empty-state">Search by name or phone.</div>{% elseif customers is empty %}<div class="empty-state">No customers found.</div>{% else %}<div class="card-list">{% for customer in customers %}<a class="card" href="{{ path('customers_show',{id:customer.id}) }}"><div><strong>{{ customer.name }}</strong><small>{{ customer.phone ?: 'No phone' }}</small></div></a>{% endfor %}</div>{% endif %}</div>{% endblock %}
