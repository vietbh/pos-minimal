{% extends 'layout/authenticated.html.twig' %}{% block title %}{{ customer ? 'customer.form_edit'|trans : 'customer.form_new'|trans }}{% endblock %}{% block authenticated_body %}<div class="app-shell"><header class="app-header"><h1>{{ customer ? 'customer.form_edit'|trans : 'customer.form_new'|trans }}</h1><a href="{{ customer ? path('customers_show',{id:customer.id}) : path('customers_index') }}">{{ 'common.back'|trans }}</a></header>{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}<form class="form-card" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_customer_form') }}"><label>{{ 'admin.name'|trans }}<input required name="name" value="{{ data.name }}"></label><label>{{ 'customer.phone'|trans }}<input inputmode="tel" name="phone" value="{{ data.phone }}"></label><label>{{ 'admin.note'|trans }}<textarea name="note">{{ data.note }}</textarea></label><label>Giảm giá mặc định (%)<input type="number" name="defaultDiscountPercent" value="{{ data.defaultDiscountPercent }}" min="0" max="100" step="1" inputmode="numeric"><small>Áp dụng tự động cho đơn hàng của khách này.</small></label><button class="primary">{{ customer ? 'admin.save_changes'|trans : 'customer.create_customer'|trans }}</button></form></div>{% endblock %}
