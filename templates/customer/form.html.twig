{% extends 'layout/authenticated.html.twig' %}
{% block title %}{{ customer ? 'customers.edit_title'|trans : 'customers.new_title'|trans }}{% endblock %}
{% block authenticated_body %}<main class="page-shell customer-form-page"><header class="page-header"><div><p class="page-eyebrow">{{ 'customers.eyebrow'|trans }}</p><h1>{{ customer ? 'customers.edit_title'|trans : 'customers.new_title'|trans }}</h1></div><a class="button" href="{{ customer ? path('customers_show',{id:customer.id}) : path('customers_index') }}">{{ 'customers.back'|trans }}</a></header>{% for message in app.flashes('error') %}<div class="flash error" role="alert">{{ message }}</div>{% endfor %}<form class="form-card customer-form" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_customer_form') }}"><label>{{ 'customers.name'|trans }}<input required name="name" value="{{ data.name }}" autocomplete="name"></label><label>{{ 'customers.phone'|trans }}<input inputmode="tel" name="phone" value="{{ data.phone }}" autocomplete="tel"></label><label>{{ 'customers.note'|trans }}<textarea name="note" rows="4">{{ data.note }}</textarea></label><button class="primary" type="submit">{{ customer ? 'customers.save'|trans : 'customers.create'|trans }}</button></form></main>{% endblock %}
