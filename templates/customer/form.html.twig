{% extends 'base.html.twig' %}{% block title %}{{ customer ? 'Edit customer' : 'New customer' }}{% endblock %}{% block body %}<div class="app-shell"><header class="app-header"><h1>{{ customer ? 'Edit customer' : 'New customer' }}</h1><a href="{{ customer ? path('customers_show',{id:customer.id}) : path('customers_index') }}">Back</a></header>{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}<form class="form-card" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_customer_form') }}"><label>Name<input required name="name" value="{{ data.name }}"></label><label>Phone<input inputmode="tel" name="phone" value="{{ data.phone }}"></label><label>Note<textarea name="note">{{ data.note }}</textarea></label><button class="primary">{{ customer ? 'Save changes' : 'Create customer' }}</button></form></div>{% endblock %}
